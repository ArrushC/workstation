# /etc/dozzle/compose.yaml — rendered by mise from configs/dozzle/compose.yaml.tera
# (vars.dozzle_version in config.toml). `docker compose -f /etc/dozzle/compose.yaml ps`
services:
  dozzle:
    image: amir20/dozzle:v{{ vars.dozzle_version }}
    container_name: dozzle
    restart: unless-stopped
    ports:
      - "127.0.0.1:8080:8080"
    environment:
      DOZZLE_LEVEL: info
      DOZZLE_NO_ANALYTICS: "true"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
