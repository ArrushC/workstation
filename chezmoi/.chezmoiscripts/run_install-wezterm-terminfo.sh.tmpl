{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# run_install-wezterm-terminfo.sh — compiles the vendored wezterm terminfo
# (chezmoi/dot_local/share/wezterm/wezterm.terminfo) into the user's ~/.terminfo/
# database via `tic`, so apps querying terminfo on this host see the wezterm entry
# advertising Tc / Smulx / Setulc (truecolor + extended underline). wezterm.lua
# sets config.term='wezterm', so without this entry every TUI errors with
# `Error opening terminal: wezterm` (and tput prints `unknown terminal "wezterm"`).
#
# Why run_ (every apply) and NOT run_onchange_:
#   run_onchange_ fires only when the script's rendered text changes, and it
#   records a soft-fail skip (tic absent because ncurses isn't installed yet) as
#   a *successful* run. If any apply beats ncurses onto PATH — a manual `cza`
#   during setup, a parallel-make race, a partial run — the compile is skipped
#   and NEVER retried until the vendored source bumps, leaving the host stuck.
#   This script runs on every apply instead and SELF-HEALS: it re-tic's whenever
#   the entry is missing (ncurses can't resolve `wezterm`) OR the source changed
#   since the last compile, and no-ops cheaply (one stamp read) once installed
#   and current.
#
# .tmpl gate: linux only. .chezmoiignore does NOT apply to .chezmoiscripts/, so
# the gate lives in the body; on non-linux hosts the file renders empty and
# chezmoi skips it.
#
# Soft-fail on missing prerequisites — `cza` is daily-workflow and must not gain
# a new failure mode just because ncurses or the source file is absent.

set -euo pipefail

SRC="$HOME/.local/share/wezterm/wezterm.terminfo"
STAMP="$HOME/.terminfo/.wezterm.srchash"

if [ ! -f "$SRC" ]; then
  printf 'wezterm.terminfo missing at %s — skipping tic\n' "$SRC" >&2
  exit 0
fi
if ! command -v tic >/dev/null 2>&1; then
  printf 'tic (ncurses) not on PATH — skipping wezterm terminfo install\n' >&2
  exit 0
fi

# Self-heal trigger: re-tic if ncurses can't resolve `wezterm` (entry missing) OR
# the vendored source changed since the last successful compile. The stamp holds
# the source hash so a bump invalidates it — mirroring the old run_onchange
# "reinstall on bump" behaviour without depending on chezmoi's content-hash gate.
want="$(sha256sum "$SRC" | cut -d' ' -f1)"
if infocmp wezterm >/dev/null 2>&1 \
   && [ "$(cat "$STAMP" 2>/dev/null || true)" = "$want" ]; then
  exit 0
fi

# -x preserves extended capabilities (Tc, Smulx, Setulc) — load-bearing.
# -o writes to user scope; no sudo needed; ncurses auto-finds ~/.terminfo/.
tic -x -o "$HOME/.terminfo" "$SRC" >/dev/null
printf '%s\n' "$want" >"$STAMP"
{{- end }}
