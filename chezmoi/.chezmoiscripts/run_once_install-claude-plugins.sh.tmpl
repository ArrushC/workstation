{{ if and (eq .chezmoi.os "linux") (hasKey . "group") (eq .group "dev_machine") -}}
#!/usr/bin/env bash
# run_once_install-claude-plugins.sh — chezmoi runs this exactly once after
# first apply on dev_machine Linux hosts. Adds the anthropics/claude-plugins-
# official marketplace at user scope and installs the eight user-scope plugins
# whose enablement is defaulted on in private_settings.json.tmpl, so a fresh
# clone reaches plugin parity with the source host after bootstrap + apply.
#
# .tmpl gate: dev_machine + linux. .chezmoiignore does NOT apply to
# .chezmoiscripts/, so the gate must live in the script itself; on
# non-matching hosts this renders to an empty file and chezmoi skips it.
#
# Idempotent: marketplace add no-ops if already present; plugin install at
# the same scope is a no-op too. lua-lsp is deliberately omitted — it stays
# project-scope, opted in only by repos that need it.

set -euo pipefail

BIN="$HOME/.local/bin"
export PATH="$BIN:$PATH"

if ! command -v claude >/dev/null 2>&1; then
  echo "claude CLI not found on PATH — skipping plugin install" >&2
  exit 0
fi

MARKETPLACE="claude-plugins-official"
SOURCE="anthropics/claude-plugins-official"

if ! claude plugin marketplace list 2>/dev/null | grep -qF "${MARKETPLACE}"; then
  claude plugin marketplace add "${SOURCE}" --scope user
fi

PLUGINS=(
  superpowers
  claude-md-management
  claude-code-setup
  microsoft-docs
  hookify
  context7
  github
  frontend-design
)

for plugin in "${PLUGINS[@]}"; do
  claude plugin install "${plugin}@${MARKETPLACE}" --scope user
done
{{- end }}
