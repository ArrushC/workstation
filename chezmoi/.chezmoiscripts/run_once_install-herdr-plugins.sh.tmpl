{{ if and (eq .chezmoi.os "linux") (hasKey . "group") (eq .group "dev_machine") -}}
#!/usr/bin/env bash
# run_once_install-herdr-plugins.sh — chezmoi runs this after apply on
# dev_machine Linux hosts, once per content hash. Installs the herdr plugins a
# fresh host needs so it reaches plugin parity with the source host after
# bootstrap + apply (same pattern as run_once_install-claude-plugins.sh).
#
# Ordering: safe — bootstrap.sh runs `make provision` (which installs herdr on
# dev) BEFORE `chezmoi init --apply`, so herdr is on PATH when this runs. The
# command -v guard below is belt-and-suspenders for a bare `chezmoi apply` on
# a host that never provisioned; bump PLUGIN_REF to re-arm the script there.
#
# .tmpl gate: dev_machine + linux. .chezmoiignore does NOT apply to
# .chezmoiscripts/, so the gate must live in the script itself; on
# non-matching hosts this renders to an empty file and chezmoi skips it.
#
# PIN: the plugin version is pinned HERE via --ref (the plugin's documented
# pinning mechanism), NOT in makefile/versions.mk — chezmoi scripts can't read
# make variables, and bridging would create a new dual-edit invariant. Bumping
# the ref changes this file's content, which makes chezmoi's run_once re-run
# it; re-running `herdr plugin install` is the plugin's documented update path
# and converges an existing install onto the new pin. herdr floor: the plugin
# needs herdr 0.7+ (HERDR_VERSION in versions.mk is >= 0.7.1).
#
# The plugin's suggested keybindings (prefix+f / prefix+shift+f) live in the
# chezmoi-tracked ~/.config/herdr/config.toml, not here. Its recommended
# renderers (glow, delta, bat) are already in the managed toolbelt.

set -euo pipefail

if ! command -v herdr >/dev/null 2>&1; then
  echo "herdr not found on PATH — skipping herdr plugin install" >&2
  exit 0
fi

herdr plugin install smarzban/herdr-file-viewer --ref v1.7.0 --yes
{{- end }}
