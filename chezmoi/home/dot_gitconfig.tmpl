# ~/.gitconfig — managed by chezmoi
[user]
    name  = {{ .name }}
    email = {{ .email }}

[core]
    editor     = hx
    autocrlf   = input
    pager      = delta

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[alias]
    st  = status
    lg  = log --oneline --graph --decorate --all
    undo = reset --soft HEAD~1
    wip  = commit -am "wip"

[color]
    ui = auto
