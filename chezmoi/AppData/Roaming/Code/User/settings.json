	"highlight.regexFlags": "g",
	"highlight.maxMatches": 1000,
	"highlight.regexes": {
		//!!!!!!!!!!  ORDER MATTERS  !!!!!!!!!!!!!!!

		// Middleware framework tags for current UI
		"(\\<WC@)([^\\s\\>]+)([^>]+)(/\\>)": {
			"decorations": [
				{
					"color": "#ffda79",
					"fontWeight": "900"
				},
				{
					"color": "#ffda79",
					"fontWeight": "900"
				},
				{},
				{
					"color": "#ffda79",
					"fontWeight": "900"
				}
			]
		},

		// Middleware framework tags
		"(<at:(?:tag|string|html))([^>]*)(/>)": {
			"filterFileRegex": ".*\\.htm",
			"decorations": [
				{
					"color": "hsl(160,100%, 50%)",
					"fontWeight": "600"
				},
				{},
				{
					"color": "hsl(160,100%, 50%)",
					"fontWeight": "600"
				}
			]
		},

		// Middleware framework if statement conditionals
		"(<)(/?at:if|/?WC@if)(.*?>)": {
			"decorations": [
				{},
				{
					"color": "hsl(50, 100%, 40%)",
					"fontWeight": "900"
				},
				{}
			]
		},

		// Hidden inputs that begin with "S_ID_NAME" or "E_ID_NAME"
		"(name=|id=|rel=|ref=|data-target=)([\\'\"])(S_|E_)([^_]+)(_)([^\"\\']+)([\"\\'])": {
			"decorations": [
				{},
				{},
				{
					"color": "#ef5777",
					"fontWeight": "600"
				},
				{},
				{},
				{
					"color": "#ef5777",
					"fontWeight": "600"
				},
				{}
			]
		},

		// Hidden inputs that begin with "S_ID_NAME" or "E_ID_NAME" containing middleware framework tags
		"(name=|id=|rel=|ref=|data-target=)([\\'\"])(S_|E_)(<at:tag|<WC@TAG)(.+?)(/>)(_)([^\"\\']+)([\"\\'])": {
			"decorations": [
				{},
				{},
				{
					"color": "#ef5777",
					"fontWeight": "600"
				},
				{},
				{},
				{},
				{},
				{
					"color": "#ef5777",
					"fontWeight": "600"
				},
				{}
			]
		},
		"(name=|id=|rel=|ref=|data-target=)([\\'\"])(I_)([^_]+)(_)([^\"\\']+)([\"\\'])": {
			// Hidden inputs that begin with "I_ID_NAME"
			"decorations": [
				{},
				{},
				{},
				{},
				{},
				{
					"color": "hsl(160,100%, 50%)",
					"fontWeight": "900"
				},
				{}
			]
		},
		"(name=|id=|rel=|ref=|data-target=)([\\'\"])(I_)(<at:tag|<WC@TAG)(.+?)(/>)(_)([^\"\\']+)([\"\\'])": {
			// Hidden inputs that begin with "I_ID_NAME" containing middleware framework tags
			"decorations": [
				{},
				{},
				{},
				{},
				{},
				{},
				{},
				{
					"color": "hsl(160,100%, 50%)",
					"fontWeight": "900"
				},
				{}
			]
		},

		"(<at:(var|math)|<WC@(VAR|MATH))(.+?)(/>)": {
			// Middleware framework tags
			"decorations": [
				{
					"color": "#00a8ff",
					"fontWeight": "600"
				},
				{},
				{
					"color": "#00a8ff",
					"fontWeight": "600"
				}
			]
		},

		"(var)(=)([\\'\"])(.*?)([\\'\"])": {
			// Middleware var declaration inside at:tag framework tags
			"decorations": [
				{
					"color": "#00a8ff",
					"fontWeight": "900"
				},
				{},
				{},
				{
					"fontWeight": "900"
				},
				{}
			]
		},

		"(<)(at:|wc@)(include|js)": {
			// Middleware framework miscellaneous tags
			"decorations": [
				{},
				{
					"color": "#FF0000"
				},
				{
					"color": "#FF0000",
					"fontWeight": "600"
				}
			]
		},

		"(<)(input)([^>]*?)(\\stype=)(['\"])(hidden(['\"])\\s)": {
			// Hidden inputs
			"decorations": [
				{},
				{
					"color": "hsl(300,60%, 60%)",
					"fontWeight": "600"
				},
				{},
				{},
				{},
				{}
			]
		},

		"(<)(/?at:else|/?WC@ELSE)(if)?(.*?>)": {
			// Middleware framework else and elseif statement conditionals
			"decorations": [
				{},
				{
					"color": "hsl(50, 100%, 40%)", // hsl(50, 100%, 80%)
					"fontWeight": "900"
				},
				{
					"color": "hsl(50, 100%, 40%)",
					"fontWeight": "900"
				},
				{}
			]
		},

		"(</?at:foreach.*?>|</?WC@FOREACH.*?>)": {
			// Middleware framework foreach statement conditionals
			"decorations": [
				{
					"fontWeight": "900"
				}
			]
		},

		"(</?)(at:xmlcontext|WC@XMLCONTEXT)": {
			"decorations": [
				{},
				{
					"color": "#38ada9",
					"fontWeight": "900"
				}
			]
		},

		"(<at:c>)(.*?)(</at:c>)": {
			// Middleware framework comments
			"decorations": [
				{
					"color": "hsl(24, 50%, 50%)",
					"fontStyle": "italic",
					"fontWeight": "900"
				},
				{},
				{
					"color": "hsl(24, 50%, 50%)",
					"fontStyle": "italic",
					"fontWeight": "900"
				}
			]
		},

		"(NEWROWTEMPLATE)": {
			// Frontend feature that replaces the new row template with the desired row id.
			"regexFlags": "gis",
			"decorations": [
				{
					"color": "hsl(300, 40%, 80%)",
					"fontWeight": "900"
				}
			]
		},

		// at-update, required and maxlength properties and validation classes
		"([\"\\'\\s])(vld-[-_a-zA-Z0-9]{1,30})([\"\\'\\s])": {
			"decorations": [
				{},

				{
					"color": "#B33771",

					"fontWeight": "900"
				},

				{}
			]
		},

		"(\\s)(readonly|required|disabled)(\\s)": {
			"decorations": [
				{},

				{
					"color": "#B33771",

					"fontWeight": "900"
				},

				{}
			]
		},

		"([\\s])(maxlength)(=)": {
			"decorations": [
				{},

				{
					"color": "#B33771",

					"fontWeight": "900"
				},

				{}
			]
		},

		"(text-uppercase|at-update[-a-zA-Z]{0,20}|at-insert[-a-zA-Z]{0,20}|at-delete[-a-zA-Z]{0,20})": {
			"decorations": [
				{
					"color": "#B33771",
					"fontWeight": "900"
				}
			]
		},

		"(at-lkup)": {
			"decorations": [
				{
					"color": "#B33771",
					"fontWeight": "900"
				}
			]
		},

		"(\\/MESSAGES\\/PAGE\\/AtcomResponse\\/|\\/MESSAGES\\/PAGE\\/AtcoreRequest|\\/MESSAGES\\/XMLDOC\\/|\\./|\\/MESSAGES\\COMMON|\\/MESSAGES\\/SETTINGS|\\/MESSAGES\\/)": {
			"decorations": [
				{
					"color": "hsl(30, 100%, 40%)",
					"fontWeight": "900"
				}
			]
		},

		"(data-bs)": {
			"decorations": [
				{
					"color": "#ac58f0",
					"fontWeight": "900"
				}
			]
		},

		"(<!-- \\$)(Id|URL)([^\\$]+)(\\$ -->)": {
			"decorations": [
				{},
				{
					"color": "#fa6fe8",
					"fontWeight": "700"
				},
				{
					"color": "#fa6fe8",
					"fontWeight": "700"
				},
				{}
			]
		}
	},
