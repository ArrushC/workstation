{
  // Minimal VSCode settings — chezmoi-managed.
  // Run `chezmoi add %APPDATA%\Code\User\settings.json` to overwrite with
  // your current VSCode config, or edit via `chezmoi edit` then `chezmoi apply`.
  "editor.fontFamily": "JetBrainsMono Nerd Font Mono, Monaspace Neon, Consolas, 'Courier New', monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "selection",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.cursorBlinking": "smooth",
  "editor.smoothScrolling": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font Mono",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "git.confirmSync": false,
  "git.autofetch": true,
  "telemetry.telemetryLevel": "off",
  "update.mode": "manual"
}
