{{/*
.chezmoiignore — files chezmoi skips when applying to the target machine.
Templated so Linux- and Windows-only files are scoped to their OS.
Paths are relative to the target $HOME (the destination), NOT the source dir.

IMPORTANT: chezmoi matches these patterns against the TARGET path (e.g.
`.bashrc`, `.config/zsh`, `.claude`), NOT the source-state name
(`dot_bashrc.tmpl`, `dot_config/zsh`, `private_dot_claude`). Writing the
source-state form is a SILENT no-op — chezmoi matches nothing and deploys the
file anyway. Always use the target path here (strip the `dot_`/`private_dot_`
prefix → `.`, drop the `.tmpl` suffix). See CLAUDE.md's ".chezmoiignore.tmpl
patterns are target paths" tripwire.
*/}}

# --- Local machine overrides — never tracked --------------------------------
.bashrc.local
.config/workstation.local.ps1
Documents/PowerShell/Microsoft.PowerShell_profile.local.ps1
Documents/WindowsPowerShell/Microsoft.PowerShell_profile.local.ps1

{{ if eq .chezmoi.os "windows" }}
# --- On Windows, ignore Linux-only dotfiles ---------------------------------
.bashrc
.zshrc
.zshenv
.nbrc
.dircolors
.gdbinit
.config/bash
.config/cheat
.config/gdb
.config/helix
.config/herdr
# pueued's systemd user unit is meaningless on Windows.
.config/systemd
.config/tealdeer
# Linux Zed settings — the Windows Zed config lives at AppData/Roaming/Zed.
.config/zed
.config/zellij
.config/zsh
# ~/.local holds the vendored batpipe bash script (.local/bin) — useless on
# Windows, so skip all of ~/.local rather than depositing it in %USERPROFILE%.
.local
# .chezmoiscripts/ entries cannot be ignored via .chezmoiignore — chezmoi
# treats scripts specially (no destination path). Linux-only scripts are
# gated inside the file via .tmpl with an OS-conditional that renders
# the body only on linux; chezmoi skips zero-byte scripts.
{{ else }}
# --- On Linux/macOS, ignore Windows-only paths ------------------------------
AppData
Documents
# .wslconfig is the Windows host's global WSL2 config; meaningless on Linux.
.wslconfig
{{ end }}

{{/*
Dev-only paths. Hosts in the prod_machine group skip Claude Code and
ccstatusline tracked files entirely — they're inert on prod (no claude
binary, no npx) and just add noise in $HOME.

The hasKey guard makes this no-op on hosts where chezmoi.toml predates
the `group` field (haven't re-run `chezmoi init` since 6035ee0). Those
hosts continue to receive the files as before; once they re-init (or
re-bootstrap), the gate engages correctly.
*/}}
{{ if and (hasKey . "group") (ne .group "dev_machine") }}
.claude
.config/ccstatusline
# GEF + its ~/.gdbinit are dev-only (gdb itself is a dev_machine dnf package).
.gdbinit
.config/gdb
# herdr is the dev_machine-only agent multiplexer; its config is inert on prod.
.config/herdr
# Zed settings serve desktop Zed and its SSH remote server on dev hosts
# (atc-cache-dev*); Zed never runs on the headless prod boxes.
.config/zed
# mise's dev-only tool set (node/go/gopls/LSP servers) — generated from
# versions.mk by scripts/gen-mise-config.sh; prod hosts get only the
# both-scopes .config/mise/conf.d/workstation.toml (uv).
.config/mise/conf.d/workstation-dev.toml
{{ end }}

