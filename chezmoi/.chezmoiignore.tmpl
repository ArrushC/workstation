{{/*
.chezmoiignore — files chezmoi skips when applying to the target machine.
Templated so Linux- and Windows-only files are scoped to their OS.
Paths are relative to the chezmoi source state root (this directory),
which is configured via .chezmoiroot at the repo root.
*/}}

# --- Local machine overrides — never tracked --------------------------------
dot_bashrc.local
dot_config/workstation.local.ps1
Documents/PowerShell/Microsoft.PowerShell_profile.local.ps1
Documents/WindowsPowerShell/Microsoft.PowerShell_profile.local.ps1

{{ if eq .chezmoi.os "windows" }}
# --- On Windows, ignore Linux-only dotfiles ---------------------------------
dot_bashrc.tmpl
dot_nbrc
dot_dircolors
dot_config/cheat
dot_config/helix
dot_config/zellij
dot_config/zsh
# .chezmoiscripts/ entries cannot be ignored via .chezmoiignore — chezmoi
# treats scripts specially (no destination path). The Linux-only init script
# is gated inside the file via .tmpl with an OS-conditional that renders
# the body only on linux; chezmoi skips zero-byte scripts.
# wezterm.lua: bootstrap.ps1 sets a User-scope WEZTERM_CONFIG_FILE env var
# pointing at the chezmoi source directly, so WezTerm reads the repo file
# without chezmoi needing to deploy a copy to %USERPROFILE%\.config\wezterm\.
# This eliminates the pre-v2 hardlink dance (which broke on chezmoi
# atomic-writes). See "WEZTERM_CONFIG_FILE" notes in CLAUDE.md + README.html.
dot_config/wezterm
{{ else }}
# --- On Linux/macOS, ignore Windows-only paths ------------------------------
AppData
Documents
# wezterm.lua is the Windows client's terminal config; the Linux hosts run no
# GUI / WezTerm, so we don't apply it there. Remove this line if you ever
# want WezTerm config on a Linux desktop.
dot_config/wezterm
{{ end }}

{{/*
Dev-only paths. Hosts in the prod_machine group skip Claude Code and
ccstatusline tracked files entirely — they're inert on prod (no claude
binary, no npx) and just add noise in $HOME.

The hasKey guard makes this no-op on hosts where chezmoi.toml predates
the `group` field (haven't re-run `chezmoi init` since 6035ee0). Those
hosts continue to receive the files as before; once they re-init (or
re-bootstrap), the gate engages correctly.
*/}}
{{ if and (hasKey . "group") (ne .group "dev_machine") }}
private_dot_claude
dot_config/ccstatusline
{{ end }}

{{/*
Per-host opt-out of the chezmoi-tracked ccstatusline widget config.
Managed by scripts/setup-ccstatusline.sh — hand-edits between markers
get clobbered on the next prompt run. Each host that picks "this
machine + persist=y" gets a single-line entry of the form:
  {{ "{{" }} if eq .chezmoi.hostname "name" {{ "}}" }}dot_config/ccstatusline/settings.json{{ "{{" }} end {{ "}}" }}
*/}}
# CCSTATUSLINE:START
# CCSTATUSLINE:END
