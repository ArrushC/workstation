// Zed settings — Linux (~/.config/zed/settings.json)
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// Chezmoi-managed:
// Run `chezmoi add ~/.config/zed/settings.json` to overwrite with your
// current Zed config, or edit this file via `chezmoi edit` and then
// `chezmoi apply`.
{
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--background-index-priority=low",
          "--background-index",
          "--header-insertion=never",
          "--completion-style=detailed",
          "--pch-storage=disk",
          "--malloc-trim"
        ]
      }
    },
    "jdtls": {
      "settings": {
        "java_home": "/usr/lib/jvm/java-21-openjdk-21.0.10.0.7-1.el8.x86_64/"
      }
    }
  },
  "terminal": {
    "detect_venv": {
      "on": {
        "directories": [".venv", "venv", "env", ".env"],
        "activate_script": "default"
      }
    }
  }
}
