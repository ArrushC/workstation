# ~/.gitconfig — managed by chezmoi
[user]
    name  = {{ .name }}
    email = {{ .email }}

[core]
    editor     = hx
    autocrlf   = input
    # `delta` is a Linux-only tool (a mise tool, config.linux.toml); it is NOT
    # present on Windows, so spawning it as the pager aborts every paging git
    # command (log/diff/show/blame). Fall back to Git-for-Windows' bundled
    # `less` there (git finds it in its own libexec even when it's not on the
    # PowerShell PATH). The [delta] sections below stay — git ignores unknown
    # sections, so they're harmless/inert on Windows.
    pager      = {{ if eq .chezmoi.os "windows" }}less{{ else }}delta{{ end }}

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[alias]
    st  = status
    lg  = log --oneline --graph --decorate --all
    undo = reset --soft HEAD~1
    wip  = commit -am "wip"

[color]
    ui = auto

[delta]
    # Catppuccin Mocha — values from github.com/catppuccin/delta (named-feature
    # block below). syntax-theme "Catppuccin Mocha" is bundled in delta 0.19.2
    # (`delta --list-syntax-themes` lists it), so no external theme files needed.
    features = catppuccin-mocha
    navigate = true
    line-numbers = true

[delta "catppuccin-mocha"]
    blame-palette = "#1e1e2e #181825 #11111b #313244 #45475a"
    commit-decoration-style = "#6c7086" bold box ul
    dark = true
    file-decoration-style = "#6c7086"
    file-style = "#cdd6f4"
    hunk-header-decoration-style = "#6c7086" box ul
    hunk-header-file-style = bold
    hunk-header-line-number-style = bold "#a6adc8"
    hunk-header-style = file line-number syntax
    line-numbers-left-style = "#6c7086"
    line-numbers-minus-style = bold "#f38ba8"
    line-numbers-plus-style = bold "#a6e3a1"
    line-numbers-right-style = "#6c7086"
    line-numbers-zero-style = "#6c7086"
    minus-emph-style = bold syntax "#694559"
    minus-style = syntax "#493447"
    plus-emph-style = bold syntax "#4e6356"
    plus-style = syntax "#394545"
    map-styles = bold purple => syntax "#5b4e74", bold blue => syntax "#445375", bold cyan => syntax "#446170", bold yellow => syntax "#6b635b"
    syntax-theme = "Catppuccin Mocha"

{{ if ne .chezmoi.os "windows" }}
# gh as the git credential helper (github.com + gists). `gh auth setup-git`
# writes these per-machine with gh's absolute path + an empty "reset" line, so
# ~/.gitconfig always drifted from this source. Track them here in PATH-relative
# form so `chezmoi status` stays clean while gh auth keeps working. gh is on
# every Linux/WSL host (a mise tool, config.linux.toml); on Windows git uses its bundled Git
# Credential Manager, so this block is Linux-only (matches the OS-gated pager).
[credential "https://github.com"]
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper = !gh auth git-credential
{{ end }}
{{- if eq .chezmoi.os "windows" }}
# Git Credential Manager (Windows-only) records the provider for the internal
# git server so it doesn't re-probe on every auth; GCM writes this to
# ~/.gitconfig on first access, which always drifted from this source. Track it
# here (Windows-gated, mirroring the Linux gh block above) so `chezmoi status`
# stays clean and `apply` won't wipe it.
[credential "https://repo.atcoretec.com"]
    provider = generic
{{- end }}
