# Managed by chezmoi (workstation repo).
# Per-machine overrides go in ~/.ssh/config.local (un-tracked).
# Include must come FIRST — Host/Match are first-match-wins for most options.
Include config.local

Host *
    ServerAliveInterval 30
    ServerAliveCountMax 3
    TCPKeepAlive yes
    ConnectTimeout 10

    # Connection multiplexing — keep a TCP socket open for 60s after the
    # first ssh exits, so subsequent ssh/scp/rsync invocations to the
    # same host reuse it (no re-handshake, no re-auth). Equivalent to
    # what the old ansible.cfg set; now applies to scripts/update-hosts.sh
    # bulk updates AND interactive ssh.
    ControlMaster auto
    ControlPersist 60s
    ControlPath ~/.ssh/cm-%r@%h:%p
