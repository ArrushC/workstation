# chezmoi.toml.tmpl — runs on `chezmoi init` to generate ~/.config/chezmoi/chezmoi.toml
# Prompts are only asked once; answers stored in chezmoi's config.

[data]
    name     = "{{ promptStringOnce . "name" "Full name" }}"
    email    = "{{ promptStringOnce . "email" "Email address" }}"
    hostname = "{{ .chezmoi.hostname }}"
    os       = "{{ .chezmoi.os }}"
    # `group` drives dev/prod conditionals in .chezmoiignore.tmpl. bootstrap.sh
    # exports WORKSTATION_GROUP from its `--dev`/`--prod` flag and chezmoi uses
    # it as the no-prompt path; running `chezmoi init` outside bootstrap falls
    # back to an interactive prompt.
    group    = "{{ if env "WORKSTATION_GROUP" }}{{ env "WORKSTATION_GROUP" }}{{ else }}{{ promptStringOnce . "group" "Machine group (dev_machine|prod_machine)" }}{{ end }}"

[edit]
    # hx isn't on Windows — use Zed there (--wait so chezmoi blocks until the
    # buffer is closed). Linux keeps helix.
    command = "{{ if eq .chezmoi.os "windows" }}zed{{ else }}hx{{ end }}"
{{- if eq .chezmoi.os "windows" }}
    args    = ["--wait"]
{{- end }}

# When the interactive apply prompt offers `diff/overwrite/skip/quit` and you
# press `d`, chezmoi pipes its unified diff into this pager. `delta` (installed
# by makefile/tools.mk on Linux) renders it as a syntax-highlighted side-by-side
# view instead of plain red/green ±. delta is NOT present on Windows, and chezmoi
# (unlike git) can't find Git's bundled `less` on the PowerShell PATH — so the
# pager is left empty on Windows and chezmoi writes the diff straight to stdout.
# (A configured-but-absent pager aborts the command; empty does not.)
[diff]
    pager = "{{ if eq .chezmoi.os "windows" }}{{ else }}delta{{ end }}"

# When the interactive apply prompt offers `m` (or you run `chezmoi merge`),
# this opens a 3-way merge. Arg order is the chezmoi standard: Destination =
# your local file, Source = chezmoi's pre-apply source state, Target = the new
# state chezmoi wants to write; chezmoi takes the final Destination as the
# resolution.
#   Linux:   vimdiff (vim-enhanced, packages.mk LINUX_OPTIONAL_PACKAGES). Edit a
#            pane, `:wqa`. Without vim-enhanced chezmoi falls back to its builtin.
#   Windows: vimdiff is unavailable (git's bundled vim isn't on the PATH chezmoi
#            sees), so use Zed — it opens the three files as tabs; reconcile into
#            Destination, save, and close them (`--wait` blocks until then).
[merge]
    command = "{{ if eq .chezmoi.os "windows" }}zed{{ else }}vimdiff{{ end }}"
{{/*
    The Destination / Source / Target refs in args below are chezmoi
    merge-time placeholders, NOT template-render data. Each open and
    close brace pair is emitted via its own escape action because Go
    template lexers close actions on the first close brace they hit;
    backtick raw strings inside an action do not shield against that.
    TOML hash comments also do not shield literal template directives
    from evaluation. Source-only notes live in Go template comments.
*/}}
    args    = [{{ if eq .chezmoi.os "windows" }}"--wait", {{ end }}"{{ "{{" }} .Destination {{ "}}" }}", "{{ "{{" }} .Source {{ "}}" }}", "{{ "{{" }} .Target {{ "}}" }}"]

[git]
    autoCommit = false
    autoPush   = false
