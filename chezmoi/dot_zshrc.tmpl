# =============================================================================
# ~/.zshrc — managed by chezmoi
# Machine: {{ .chezmoi.hostname }} | User: {{ .chezmoi.username }}
# =============================================================================

# Not running interactively? Stop here.
[[ -o interactive ]] || return

# --- PATH --------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"

# --- WSL: re-add curated Windows PATH dirs -----------------------------------
# WSL2 with appendWindowsPath=true tacks the whole Windows %PATH% (~90 /mnt/c
# dirs) onto $PATH. Every exec.LookPath / `command -v` for a binary not present
# on the Windows side then stat-walks all of them across the slow 9p/drvfs
# mount — e.g. chezmoi probing for wl-copy/xclip/xsel at startup, which turned
# `czt` (chezit, several chezmoi invocations) into a multi-second launch
# (~1.6s per `chezmoi status`). Fix: appendWindowsPath=false in /etc/wsl.conf
# drops the lot; this re-adds back ONLY the Windows dirs we still call from
# WSL — PowerShell (notify.sh's toast hook → powershell.exe) and system32
# (clip.exe). Each guard is a no-op if the dir is already on PATH, so this is
# harmless on hosts still running appendWindowsPath=true. Add more Windows
# dirs (e.g. VS Code's bin) in ~/.zshrc.local if you want them back.
if [[ -n "$WSL_DISTRO_NAME" ]]; then
  for _wd in \
    "/mnt/c/WINDOWS/System32/WindowsPowerShell/v1.0" \
    "/mnt/c/WINDOWS/system32"; do
    case ":$PATH:" in
      *":$_wd:"*|*":$_wd/:"*) ;;   # already present (Windows lists these with a trailing slash)
      *) [[ -d "$_wd" ]] && PATH="$PATH:$_wd" ;;
    esac
  done
  unset _wd
  export PATH
fi

# --- Core env ----------------------------------------------------------------
export EDITOR="hx"
export VISUAL="hx"
{{ if and (hasKey . "group") (eq .group "dev_machine") }}
# Helix runtime path — dev_machine only. `make` installs the runtime to
# $HELIX_RUNTIME_DEST/runtime (= /usr/local/lib/helix/runtime on dev; see
# makefile/scope.mk). Helix's only default search paths are
# ~/.config/helix/runtime and <bin>/runtime — neither is that dir — so without
# this export Helix finds NO runtime and silently falls back to its built-in
# (purple) default theme, ignoring `theme =` in config.toml. prod installs the
# runtime to ~/.config/helix/runtime (already a default search path), hence the
# dev gate. KEEP IN SYNC with HELIX_RUNTIME_DEST in makefile/scope.mk.
export HELIX_RUNTIME="/usr/local/lib/helix/runtime"
{{ end }}
export PAGER="less"
# Colorized man pages via bat when available; plain less otherwise.
if command -v bat &>/dev/null; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT="-c"
else
  export MANPAGER="less"
fi
export COLORTERM=truecolor   # WezTerm advertises 24-bit RGB; apps honor this env-var convention (helix, zellij, starship, glow, eza, fzf, bat).

# --- History -----------------------------------------------------------------
# HISTSIZE = lines kept in memory; SAVEHIST = lines kept on disk.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=20000
setopt APPEND_HISTORY        # don't clobber on shell exit
setopt INC_APPEND_HISTORY    # write each command as it's entered, not at exit
setopt SHARE_HISTORY         # share history across concurrent sessions
setopt HIST_IGNORE_DUPS      # don't store consecutive duplicates
setopt HIST_IGNORE_ALL_DUPS  # remove older duplicates when a new one is added
setopt HIST_FIND_NO_DUPS     # don't show dupes when searching
setopt HIST_REDUCE_BLANKS    # trim whitespace before storing

# --- Shell behavior ----------------------------------------------------------
setopt EXTENDED_GLOB         # **/ recursion, ~ for negation, etc.
setopt INTERACTIVE_COMMENTS  # # comments on the interactive command line
setopt AUTO_CD               # bare directory name = cd into it
setopt NO_BEEP

# --- Colors (dircolors / LS_COLORS) ------------------------------------------
# Theme file-type/extension colors from ~/.dircolors (Catppuccin Mocha). Sets
# and exports LS_COLORS, consumed by eza, GNU ls --color, fzf, and the
# completion list-colors below. Falls back to dircolors' built-in palette if
# the dotfile isn't applied yet. No-op if dircolors is absent.
if command -v dircolors &>/dev/null; then
  if [[ -r "$HOME/.dircolors" ]]; then
    eval "$(dircolors -b "$HOME/.dircolors")"
  else
    eval "$(dircolors -b)"
  fi
fi

# --- Completion --------------------------------------------------------------
# -C skips the .zcompdump security check (faster startup). Rebuild .zcompdump
# weekly to pick up newly installed completions:
#   rm -f ~/.zcompdump && exec zsh
autoload -Uz compinit && compinit -C

# Color completion menus (filenames) with the same LS_COLORS palette.
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# --- fzf ---------------------------------------------------------------------
export FZF_DEFAULT_OPTS="
  --height 40%
  --layout=reverse
  --border
  --info=inline
  --bind='ctrl-/:toggle-preview'
  --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
  --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
  --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8
  --color=selected-bg:#45475a,border:#6c7086,label:#cdd6f4
"

# fzf shell integration (Ctrl+T, Ctrl+R, Alt+C)
if command -v fzf &>/dev/null; then
  eval "$(fzf --zsh)"
fi

# fzf + ripgrep for file content search (falls back to find)
if command -v rg &>/dev/null; then
  export FZF_DEFAULT_COMMAND='rg --files --hidden --follow --glob "!.git"'
else
  export FZF_DEFAULT_COMMAND='find . -type f -not -path "*/.git/*"'
fi

# --- zoxide (smarter cd) -----------------------------------------------------
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
  # z = jump, zi = interactive fuzzy jump
fi

# --- starship prompt ---------------------------------------------------------
if command -v starship &>/dev/null; then
  eval "$(starship init zsh)"
fi

# --- WezTerm OSC 7 (cwd tracking for new tabs/panes) -------------------------
# Emit the current working directory as an OSC 7 file:// URL after every
# prompt so WezTerm tracks cwd. New WezTerm tabs (CTRL+SHIFT+T) and panes
# then start in the same directory as the parent pane instead of falling
# back to wezterm's own cwd (a Windows path for WSL hosts, a stale path
# for SSH'd hosts). Harmless on terminals that don't speak OSC 7 — they
# ignore the sequence. `add-zsh-hook -Uz` is idempotent: re-sourcing this
# file won't double-register the hook.
__wezterm_osc7() {
  printf '\033]7;file://%s%s\033\\' "${HOST:-${HOSTNAME:-$(hostname)}}" "$PWD"
}
autoload -Uz add-zsh-hook
add-zsh-hook -Uz precmd __wezterm_osc7

# --- nb (notes) --------------------------------------------------------------
export NBRC_PATH="$HOME/.nbrc"
export NB_DIR="$HOME/notes"

# --- Aliases — navigation ----------------------------------------------------
alias ..='cd ..'
alias ...='cd ../..'
alias l='eza --group-directories-first --icons=auto --hyperlink'
alias la='eza -a --group-directories-first --icons=auto --hyperlink'
alias ll='eza -lah --group-directories-first --icons=auto --git --time-style=long-iso --hyperlink'
alias lt='eza --tree --level=2 --group-directories-first --icons=auto --hyperlink'
alias lta='eza --tree --level=2 -a --git-ignore --group-directories-first --icons=auto --hyperlink'
alias ltl='eza --tree --level=2 -lh --git --group-directories-first --icons=auto --time-style=long-iso --hyperlink'
alias grep='grep --color=auto'

# --- Aliases — git -----------------------------------------------------------
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph --decorate'
alias gd='git diff'
alias gco='git checkout'
alias gbr='git branch'

# --- Aliases — tools ---------------------------------------------------------
alias notes='nb'
alias preview='glow'
alias zj='zellij'
alias zjl='zellij list-sessions'
alias zja='zellij attach'

# --- Aliases — chezmoi -------------------------------------------------------
alias cz='chezmoi'
alias cza='chezmoi apply'
alias cze='chezmoi edit'
alias czd='chezmoi diff'
alias czu='chezmoi update'
alias czs='chezmoi status'
alias czt='chezit'

# --- Aliases — web admin services (dev_machine only) -------------------------
# Quick health-check / log-tail / restart shortcuts for the Dozzle + Cockpit
# services provisioned by `make dozzle-service` / `make cockpit-service`. On
# prod_machine hosts these target non-existent units; systemctl prints a
# "not found" error harmlessly. Keeping the aliases everywhere for parity.
alias dozzle-status='systemctl status dozzle.service'
alias dozzle-logs='journalctl -u dozzle.service -f'
alias dozzle-restart='sudo systemctl restart dozzle.service'
alias cockpit-status='systemctl status cockpit.socket'

# --- Functions ---------------------------------------------------------------

# czh — chezmoi cheatsheet. Single source of truth for the cz* aliases +
# the common edit→diff→apply flow + how to push tracked changes upstream.
czh() {
  cat <<'EOF'
chezmoi aliases:
  cz   chezmoi                    raw — pass any subcommand
  cze  chezmoi edit <path>        edit a tracked file in source state
  czd  chezmoi diff               preview pending changes to ~
  cza  chezmoi apply              write tracked state to ~
  czu  chezmoi update             git pull + apply (sync repo + ~)
  czs  chezmoi status             list managed files + their state
  czt  chezit                     TUI (status / files / diff / commands tabs)

Common flow:
  cze ~/.zshrc        (edit in source state)
  czd                 (preview the change)
  cza                 (apply to ~)

Push tracked changes upstream:
  cd ~/.local/share/chezmoi && git add -A && git commit -m '...' && git push

Per-machine overrides (untracked):
  ~/.zshrc.local                                               (Linux)
  ...PowerShell\Microsoft.PowerShell_profile.local.ps1         (Windows)
EOF
}

# fzf-powered history search (Ctrl+R is already enhanced by `fzf --zsh`;
# this is the explicit-invocation alternative that picks unique entries).
# `fc -l 1` lists history from event 1 (zsh's `history` defaults to last 16).
fh() {
  local cmd
  cmd=$(fc -l 1 | awk '{$1=""; print substr($0,2)}' | sort -u | fzf --tac)
  [[ -n "$cmd" ]] && eval "$cmd"
}

# fzf cd into any subdirectory
fcd() {
  local dir
  dir=$(find "${1:-.}" -type d 2>/dev/null | fzf +m)
  [[ -n "$dir" ]] && cd "$dir"
}

# fzf ssh — pick from ~/.ssh/config hosts
fssh() {
  local host
  host=$(grep -E "^Host " ~/.ssh/config 2>/dev/null | awk '{print $2}' | fzf)
  [[ -n "$host" ]] && ssh "$host"
}

# Start or attach to a named zellij session
zs() {
  local session="${1:-main}"
  zellij attach --create "$session"
}

# Quick note with nb
n() {
  if [[ $# -eq 0 ]]; then
    nb list
  else
    nb add "$*"
  fi
}

# glow with fzf — browse and preview notes
nf() {
  local file
  file=$(find "$NB_DIR" -name "*.md" 2>/dev/null | fzf --preview 'glow {}')
  [[ -n "$file" ]] && glow "$file"
}

# --- Machine-specific overrides ----------------------------------------------
# Sourced last so they can override anything above
{{ if eq .chezmoi.hostname "rhel-dev-01" }}
export PROJECT_ROOT="/opt/projects"
{{ else }}
export PROJECT_ROOT="$HOME/projects"
{{ end }}

[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
