# --- Aliases — web admin services (dev_machine only) -------------------------
# Quick health-check / log-tail / restart shortcuts for the Dozzle + Cockpit
# services provisioned by `make dozzle-service` / `make cockpit-service`. On
# prod_machine hosts these target non-existent units; systemctl prints a
# "not found" error harmlessly. Keeping the aliases everywhere for parity.
alias dozzle-status='systemctl status dozzle.service'
alias dozzle-logs='journalctl -u dozzle.service -f'
alias dozzle-restart='sudo systemctl restart dozzle.service'
alias cockpit-status='systemctl status cockpit.socket'

# --- Functions ---------------------------------------------------------------

# czh — chezmoi cheatsheet. Single source of truth for the cz* aliases +
# the common edit→diff→apply flow + how to push tracked changes upstream.
czh() {
  cat <<'EOF'
chezmoi aliases:
  cz   chezmoi                    raw — pass any subcommand
  cze  chezmoi edit <path>        edit a tracked file in source state
  czd  chezmoi diff               preview pending changes to ~
  cza  chezmoi apply              write tracked state to ~
  czu  chezmoi update             git pull + apply (sync repo + ~)
  czs  chezmoi status             list managed files + their state
  czt  chezit                     TUI (status / files / diff / commands tabs)

Common flow:
  cze ~/.zshrc        (edit in source state)
  czd                 (preview the change)
  cza                 (apply to ~)

Push tracked changes upstream:
  cd ~/.local/share/chezmoi && git add -A && git commit -m '...' && git push

Per-machine overrides (untracked):
  ~/.zshrc.local                                               (Linux)
  ...PowerShell\Microsoft.PowerShell_profile.local.ps1         (Windows)
EOF
}

# fzf-powered history search (Ctrl+R is already enhanced by `fzf --zsh`;
# this is the explicit-invocation alternative that picks unique entries).
# `fc -l 1` lists history from event 1 (zsh's `history` defaults to last 16).
fh() {
  local cmd
  cmd=$(fc -l 1 | awk '{$1=""; print substr($0,2)}' | sort -u | fzf --tac)
  [[ -n "$cmd" ]] && eval "$cmd"
}

# fzf cd into any subdirectory
fcd() {
  local dir
  dir=$(find "${1:-.}" -type d 2>/dev/null | fzf +m)
  [[ -n "$dir" ]] && cd "$dir"
}

# fzf ssh — pick from ~/.ssh/config hosts
fssh() {
  local host
  host=$(grep -E "^Host " ~/.ssh/config 2>/dev/null | awk '{print $2}' | fzf)
  [[ -n "$host" ]] && ssh "$host"
}

# ssh — launched from WezTerm, keep TERM=wezterm only if the remote actually has
# the wezterm terminfo; otherwise fall back to xterm-256color so `clear`/TUIs
# don't error with `unknown terminal type` on hosts not provisioned with this
# repo. Fail-safe: anything uncertain (unparsable dest, probe timeout, password-
# only host with no live ControlMaster) downgrades; we only *upgrade* on a
# positive infocmp. Bypass once with `command ssh …`; disable permanently via
# `unset -f ssh` in ~/.zshrc.local. PARITY: identical body in dot_bashrc.tmpl.
ssh() {
  if [ "$TERM" != wezterm ]; then
    command ssh "$@"
    return
  fi

  # Destination = first bareword that isn't an option or an option's value.
  local arg dest='' expect_val=0
  local val_flags='bcDEeFIiJLlmOopRSWw'
  for arg in "$@"; do
    if [ "$expect_val" = 1 ]; then
      expect_val=0
      continue
    fi
    case $arg in
    --) continue ;;
    -[$val_flags]) expect_val=1 ;;
    -[$val_flags]*) continue ;;
    -*) continue ;;
    *)
      dest=${arg#*@}
      break
      ;;
    esac
  done

  # Default to the safe fallback; only upgrade on a positive non-interactive
  # probe. -o BatchMode=yes never prompts; the probe reuses the ControlMaster
  # socket (ControlMaster auto / ControlPersist 60s, Linux/WSL) so it's cheap.
  local term=xterm-256color
  if [ -n "$dest" ] &&
    command ssh -o BatchMode=yes -o ConnectTimeout=5 "$dest" \
      'infocmp wezterm >/dev/null 2>&1'; then
    term=wezterm
  fi

  TERM=$term command ssh "$@"
}

# Start or attach to a named zellij session
zs() {
  local session="${1:-main}"
  zellij attach --create "$session"
}

# Quick note with nb
n() {
  if [[ $# -eq 0 ]]; then
    nb list
  else
    nb add "$*"
  fi
}

# glow with fzf — browse and preview notes
nf() {
  local file
  file=$(find "$NB_DIR" -name "*.md" 2>/dev/null | fzf --preview 'glow {}')
  [[ -n "$file" ]] && glow "$file"
}

# yazi file manager — `y` opens it; on quit, cd to wherever you ended up.
y() {
  local tmp cwd
  tmp="$(mktemp -t yazi-cwd.XXXXXX)"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
    builtin cd -- "$cwd"
  fi
  command rm -f -- "$tmp"
}

# nnn file manager — `nn` opens it; on quit, cd to wherever you ended up.
nn() {
  local tmp
  tmp="$(mktemp -t nnn-cwd.XXXXXX)"
  # NNN_TMPFILE scoped to this call only (no env leak into a later bare `nnn`).
  NNN_TMPFILE="$tmp" command nnn "$@"
  [[ -s "$tmp" ]] && source "$tmp"
  command rm -f -- "$tmp"
}

