# =============================================================================
# ~/.zshenv — managed by chezmoi. Sourced by EVERY zsh: login, interactive,
# `zsh -c`, and the shell sshd spawns for `ssh host cmd`. Keep it tiny: two
# guarded PATH prepends and nothing else.
# =============================================================================

# --- ~/.local/bin: user-level tools for NON-interactive shells ---------------
# python-env's launchers (wpy/textual/typer), claude, and on prod_machine every
# eget-installed tool live here; ~/.zshrc only prepends it for interactive
# shells. (This host's pre-chezmoi ~/.zshenv, written by another installer,
# carried exactly this line — preserved on takeover.) Guarded: zsh re-reads
# this file in every subshell.
case ":$PATH:" in
*":$HOME/.local/bin:"*) ;;
*) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# --- mise shims: runtimes for NON-interactive shells -------------------------
# node / go / uv / gopls / the LSP servers are mise-managed (make
# mise-runtimes). Interactive shells get the real bin dirs from `mise activate
# zsh` (~/.zshrc); everything else — Make over update-hosts.sh, `ssh host
# cmd`, IDE/LSP spawns — only sees them through mise's shims dir. Prepended
# AFTER ~/.local/bin so the shims sit in front of it. PARITY: dot_bashrc.tmpl
# carries the bash twin above its interactive guard.
case ":$PATH:" in
*":$HOME/.local/share/mise/shims:"*) ;;
*) export PATH="$HOME/.local/share/mise/shims:$PATH" ;;
esac
