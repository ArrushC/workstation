# =============================================================================
# ~/.bashrc — managed by chezmoi
# Machine: {{ .chezmoi.hostname }} | User: {{ .chezmoi.username }}
# =============================================================================

# Not running interactively? Stop here.
[[ $- != *i* ]] && return

# --- PATH --------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"

# --- Core env ----------------------------------------------------------------
export EDITOR="hx"
export VISUAL="hx"
export PAGER="less"
export MANPAGER="less"
export COLORTERM=truecolor   # WezTerm advertises 24-bit RGB; apps honor this env-var convention (helix, zellij, starship, glow, eza, fzf, bat).

# --- History -----------------------------------------------------------------
# HISTSIZE = lines kept in memory; HISTFILESIZE = lines kept on disk.
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTCONTROL=ignoredups:erasedups   # drop dupes, including older ones
shopt -s histappend                        # append on exit instead of clobbering

# --- Shell behavior ----------------------------------------------------------
shopt -s checkwinsize     # refresh LINES/COLUMNS after each command
shopt -s globstar         # ** matches files/dirs recursively

# --- Completion --------------------------------------------------------------
# bash tab-completion is provided by the system-wide bash-completion package
# (sourced via /etc/profile.d/bash_completion.sh on most distros), so there's
# nothing to initialize here. zsh's parity file calls `compinit` explicitly
# because zsh has no equivalent system-wide loader.

# --- fzf ---------------------------------------------------------------------
export FZF_DEFAULT_OPTS="
  --height 40%
  --layout=reverse
  --border
  --info=inline
  --bind='ctrl-/:toggle-preview'
  --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
  --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
  --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8
  --color=selected-bg:#45475a,border:#6c7086,label:#cdd6f4
"

# fzf shell integration
if command -v fzf &>/dev/null; then
  eval "$(fzf --bash)"
fi

# fzf + ripgrep for file content search (falls back to find)
if command -v rg &>/dev/null; then
  export FZF_DEFAULT_COMMAND='rg --files --hidden --follow --glob "!.git"'
else
  export FZF_DEFAULT_COMMAND='find . -type f -not -path "*/.git/*"'
fi

# --- zoxide (smarter cd) -----------------------------------------------------
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init bash)"
  # z = jump, zi = interactive fuzzy jump
fi

# --- starship prompt ---------------------------------------------------------
if command -v starship &>/dev/null; then
  eval "$(starship init bash)"
fi

# --- WezTerm OSC 7 (cwd tracking for new tabs/panes) -------------------------
# Emit the current working directory as an OSC 7 file:// URL after every
# prompt so WezTerm tracks cwd. New WezTerm tabs (CTRL+SHIFT+T) and panes
# then start in the same directory as the parent pane instead of falling
# back to wezterm's own cwd (a Windows path for WSL hosts, a stale path for
# SSH'd hosts). Harmless on terminals that don't speak OSC 7 — they ignore
# the sequence. The case-guard prevents double-registration if the bashrc
# gets sourced twice in the same shell.
__wezterm_osc7() {
  printf '\033]7;file://%s%s\033\\' "${HOSTNAME:-$(hostname)}" "$PWD"
}
case ":${PROMPT_COMMAND:-}:" in
  *:__wezterm_osc7:*) ;;
  *) PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND;}__wezterm_osc7" ;;
esac

# --- nb (notes) --------------------------------------------------------------
export NBRC_PATH="$HOME/.nbrc"
export NB_DIR="$HOME/notes"

# --- Aliases — navigation ----------------------------------------------------
alias ..='cd ..'
alias ...='cd ../..'
alias l='eza --group-directories-first --icons=auto --hyperlink'
alias la='eza -a --group-directories-first --icons=auto --hyperlink'
alias ll='eza -lah --group-directories-first --icons=auto --git --time-style=long-iso --hyperlink'
alias lt='eza --tree --level=2 --group-directories-first --icons=auto --hyperlink'
alias lta='eza --tree --level=2 -a --git-ignore --group-directories-first --icons=auto --hyperlink'
alias ltl='eza --tree --level=2 -lh --git --group-directories-first --icons=auto --time-style=long-iso --hyperlink'
alias grep='grep --color=auto'

# --- Aliases — git -----------------------------------------------------------
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph --decorate'
alias gd='git diff'
alias gco='git checkout'
alias gbr='git branch'

# --- Aliases — tools ---------------------------------------------------------
alias notes='nb'
alias preview='glow'
alias zj='zellij'
alias zjl='zellij list-sessions'
alias zja='zellij attach'

# --- Aliases — chezmoi -------------------------------------------------------
alias cz='chezmoi'
alias cza='chezmoi apply'
alias cze='chezmoi edit'
alias czd='chezmoi diff'
alias czu='chezmoi update'
alias czs='chezmoi status'
alias czt='chezit'

# --- Aliases — web admin services (dev_machine only) -------------------------
# Quick health-check / log-tail / restart shortcuts for the Dozzle + Cockpit
# services provisioned by `make dozzle-service` / `make cockpit-service`. On
# prod_machine hosts these target non-existent units; systemctl prints a
# "not found" error harmlessly. Keeping the aliases everywhere for parity.
alias dozzle-status='systemctl status dozzle.service'
alias dozzle-logs='journalctl -u dozzle.service -f'
alias dozzle-restart='sudo systemctl restart dozzle.service'
alias cockpit-status='systemctl status cockpit.socket'

# --- Functions ---------------------------------------------------------------

# czh — chezmoi cheatsheet. Single source of truth for the cz* aliases +
# the common edit→diff→apply flow + how to push tracked changes upstream.
czh() {
  cat <<'EOF'
chezmoi aliases:
  cz   chezmoi                    raw — pass any subcommand
  cze  chezmoi edit <path>        edit a tracked file in source state
  czd  chezmoi diff               preview pending changes to ~
  cza  chezmoi apply              write tracked state to ~
  czu  chezmoi update             git pull + apply (sync repo + ~)
  czs  chezmoi status             list managed files + their state
  czt  chezit                     TUI (status / files / diff / commands tabs)

Common flow:
  cze ~/.bashrc       (edit in source state)
  czd                 (preview the change)
  cza                 (apply to ~)

Push tracked changes upstream:
  cd ~/.local/share/chezmoi && git add -A && git commit -m '...' && git push

Per-machine overrides (untracked):
  ~/.bashrc.local                                              (Linux)
  ...PowerShell\Microsoft.PowerShell_profile.local.ps1         (Windows)
EOF
}

# fzf-powered history search (Ctrl+R enhanced)
fh() {
  local cmd
  cmd=$(history | awk '{$1=""; print substr($0,2)}' | sort -u | fzf --tac)
  [[ -n "$cmd" ]] && eval "$cmd"
}

# fzf cd into any subdirectory
fcd() {
  local dir
  dir=$(find "${1:-.}" -type d 2>/dev/null | fzf +m)
  [[ -n "$dir" ]] && cd "$dir"
}

# fzf ssh — pick from ~/.ssh/config hosts
fssh() {
  local host
  host=$(grep -E "^Host " ~/.ssh/config 2>/dev/null | awk '{print $2}' | fzf)
  [[ -n "$host" ]] && ssh "$host"
}

# Start or attach to a named zellij session
zs() {
  local session="${1:-main}"
  zellij attach --create "$session"
}

# Quick note with nb
n() {
  if [[ $# -eq 0 ]]; then
    nb list
  else
    nb add "$*"
  fi
}

# glow with fzf — browse and preview notes
nf() {
  local file
  file=$(find "$NB_DIR" -name "*.md" 2>/dev/null | fzf --preview 'glow {}')
  [[ -n "$file" ]] && glow "$file"
}

# --- Machine-specific overrides ----------------------------------------------
# Sourced last so they can override anything above
{{ if eq .chezmoi.hostname "rhel-dev-01" }}
export PROJECT_ROOT="/opt/projects"
{{ else }}
export PROJECT_ROOT="$HOME/projects"
{{ end }}

[[ -f "$HOME/.bashrc.local" ]] && source "$HOME/.bashrc.local"
