# =============================================================================
# ~/.zshenv — managed by mise dotfiles. Sourced by EVERY zsh: login, interactive,
# `zsh -c`, and the shell sshd spawns for `ssh host cmd`. Keep it tiny: three
# exports and nothing else.
# =============================================================================

# --- ~/.local/bin: user-level tools for NON-interactive shells ---------------
# python-env's launchers (wpy/textual/typer), claude, and on a shared host every
# eget-installed tool live here; ~/.zshrc only prepends it for interactive
# shells. (Some hosts' stock ~/.zshenv carries this same line.) Guarded: zsh
# re-reads this file in every subshell.
case ":$PATH:" in
*":$HOME/.local/bin:"*) ;;
*) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# --- mise shims: tools for NON-interactive shells -----------------------------
# node / go / uv / gopls / the LSP servers are mise-managed, declared in
# ~/.config/mise/config*.toml (this checkout). Interactive shells get the
# real bin dirs from `mise activate zsh` (~/.zshrc); everything else — `make`
# via `ssh host cmd`, IDE/LSP spawns — only sees them
# through mise's shims dir. Prepended AFTER ~/.local/bin so the shims sit in
# front of it. PARITY: bashrc.tera carries the bash twin above its
# interactive guard.
case ":$PATH:" in
*":$HOME/.local/share/mise/shims:"*) ;;
*) export PATH="$HOME/.local/share/mise/shims:$PATH" ;;
esac

# --- MISE_ENV: which config.<env>.toml files mise loads on this host ---------
# Computed once by bootstrap.sh (scripts/lib/mise-env.sh) and persisted here so
# every zsh — interactive, `ssh host cmd`, cron — sees the same tool set.
export MISE_ENV="{% if vars.mode is defined and vars.mode == "owned" %}linux,owned,host,{% if "microsoft" in (exec(command="uname -r") | lower) %}wsl{% else %}native{% endif %}{% else %}linux{% endif %}"
