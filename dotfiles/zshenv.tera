# =============================================================================
# ~/.zshenv — managed by mise dotfiles. Sourced by EVERY zsh: login, interactive,
# `zsh -c`, and the shell sshd spawns for `ssh host cmd`. Keep it tiny: two
# exports and nothing else.
# =============================================================================

# --- ~/.local/bin: user-level tools for NON-interactive shells ---------------
# python-env's launchers (wpy/textual/typer) and claude live here; ~/.zshrc
# only prepends it for interactive shells. (Some hosts' stock ~/.zshenv carries
# this same line.) Guarded: zsh re-reads this file in every subshell.
case ":$PATH:" in
*":$HOME/.local/bin:"*) ;;
*) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# --- mise shims: tools for NON-interactive shells -----------------------------
# node / go / uv / gopls / the LSP servers are mise-managed, declared in
# ~/.config/mise/config*.toml (this checkout). Interactive shells get the
# real bin dirs from `mise activate zsh` (~/.zshrc); everything else — `make`
# via `ssh host cmd`, IDE/LSP spawns — only sees them
# through mise's shims dir. Prepended AFTER ~/.local/bin so the shims sit in
# front of it. PARITY: bashrc.tera carries the bash twin above its
# interactive guard.
case ":$PATH:" in
*":$HOME/.local/share/mise/shims:"*) ;;
*) export PATH="$HOME/.local/share/mise/shims:$PATH" ;;
esac
