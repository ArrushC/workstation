{
  "description": "One-line orchestration context for the session's repository (ws-agent context).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/context.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
