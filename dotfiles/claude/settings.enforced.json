{
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "refreshInterval": 10
  },
  "theme": "custom:catppuccin-mocha",
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "env": {
    "ARCHIFY_UPDATE_CHECK_DISABLED": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Read|Bash",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.claude/hooks/secret-guard.sh\"" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.claude/hooks/dangerous-command-guard.sh\"" }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.claude/notify.sh\" 'Claude Code' 'needs your approval' < /dev/null" }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.claude/notify.sh\" 'Claude Code' 'waiting for your next prompt' < /dev/null" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git stash list:*)",
      "Bash(git remote:*)",
      "Bash(git tag:*)",
      "Bash(git rev-parse:*)",
      "Bash(git describe:*)",
      "Bash(git shortlog:*)",
      "Bash(git grep:*)",
      "Bash(git check-ignore:*)",
      "Bash(git worktree list:*)",
      "Bash(svn status:*)",
      "Bash(svn log:*)",
      "Bash(svn diff:*)",
      "Bash(svn info:*)",
      "Bash(svn cat:*)",
      "Bash(svn list:*)",
      "Bash(svn blame:*)",
      "Bash(svn propget:*)",
      "Bash(svn proplist:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rgrep:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(bat:*)",
      "Bash(eza:*)",
      "Bash(sg:*)",
      "Bash(tree:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(readlink:*)",
      "Bash(realpath:*)",
      "Bash(dirname:*)",
      "Bash(basename:*)",
      "Bash(pwd:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(diff:*)",
      "Bash(delta:*)",
      "Bash(difft:*)",
      "Bash(sd:*)",
      "Bash(choose:*)",
      "Bash(mlr:*)",
      "Bash(qsv:*)",
      "Bash(datamash:*)",
      "Bash(patch --dry-run:*)",
      "Bash(uname:*)",
      "Bash(date:*)",
      "Bash(whoami:*)",
      "Bash(id:*)",
      "Bash(which:*)",
      "Bash(type:*)",
      "Bash(ps:*)",
      "Bash(hostname:*)",
      "Bash(env:*)",
      "Bash(nm:*)",
      "Bash(ldd:*)",
      "Bash(strings:*)",
      "Bash(objdump:*)",
      "Bash(xxd:*)",
      "Bash(od:*)",
      "Bash(hexyl:*)",
      "Bash(ug:*)",
      "Bash(scc:*)",
      "Bash(dust:*)",
      "Bash(procs:*)",
      "Bash(dysk:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(curl:*)",
      "Bash(notify-send:*)",
      "Bash(bear:*)",
      "Bash(compiledb:*)",
