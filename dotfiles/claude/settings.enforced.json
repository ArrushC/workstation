      "Bash(graft:*)",
      "Bash(npx graft:*)",
      "Bash(graft-dev:*)",
      "Bash(node dist/cli.js:*)",
      "Bash(omm:*)",
      "mcp__graft__graft_find_code",
      "mcp__graft__graft_find_all",
      "mcp__graft__graft_trace_calls",
      "mcp__graft__graft_file_api",
      "mcp__graft__graft_repo_map",
      "mcp__graft__graft_check_freshness",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__get-library-docs",
      "mcp__plugin_context7_context7__authenticate",
      "mcp__plugin_context7_context7__complete_authentication"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "microsoft-docs@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "workstation-lsp@skills-dir": true,
    "workstation-orchestration@skills-dir": true,
    "clangd-lsp@claude-plugins-official": false
  }
}
