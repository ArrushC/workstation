# =============================================================================
# config.nu — Nushell config, managed by mise dotfiles
# Machine: {{ env.COMPUTERNAME | default(value="") }} | User: {{ env.USERNAME | default(value="") }}
#
# Deploys to %APPDATA%\nushell\config.nu (Windows only — the whole AppData tree
# is declared only in config.windows.toml, never gated for Linux). Nushell is the default LOCAL Windows
# shell (the Windows Terminal "Nushell" profile); PowerShell stays installed
# for .NET/COM tasks and the WSL2 notify hook.
#
# This file owns the HAND-WRITTEN config (aliases, env, keys, helpers). The tool init
# code is GENERATED into %APPDATA%\nushell\vendor\autoload\ (auto-sourced at startup,
# so no `source` lines here) by scripts/nu-init.nu: starship.nu, mise.nu, zoxide.nu
# and atuin.nu. The `nu-init` mise task reruns it after every tools phase (the
# Windows post-tools hook), so a tool update reaches the next Nushell tab.
#
# PARITY NOTE: the ws*/g* aliases below mirror the PowerShell profile
# (Documents/PowerShell/Microsoft.PowerShell_profile.ps1.tera). Keep the two in
# sync when adding or renaming an alias so both Windows shells behave the same.
# The eza listings and `y` mirror the PowerShell profile too; keybindings, hooks and the external completer are Nushell-only.
#
# Per-machine overrides (untracked): drop a `*.nu` file into
# %APPDATA%\nushell\autoload\ (the user autoload dir; vendor\autoload is nu-init's).
# =============================================================================

# --- Shell behaviour --------------------------------------------------------
# Mutate fields on the pre-populated default $env.config (never reassign the
# whole record — that would wipe Nushell's defaults).
$env.config.show_banner = false

# Ctrl-O opens the command line in Helix; EDITOR serves everything else.
$env.EDITOR = "hx"
$env.config.buffer_editor = "hx"
# Windows Terminal and Warp draw 24-bit colour; COLORTERM tells bat, delta, glow, eza and
# helix so (without it bat falls back to 256 colours). PARITY: the PowerShell profile and
# the Linux zshrc/bashrc set it too.
$env.COLORTERM = "truecolor"
# WezTerm sets TERM=wezterm for every pane it starts. Windows has no terminfo database, so a
# program that reads TERM (Neovim) falls back to a bare 'ansi' entry for a name it doesn't
# know: xterm-256color (WezTerm's default TERM) keeps it on its full built-in entry.
# ssh from here sends it too; WezTerm's SSH launch entries keep wezterm where the host has
# the entry. PARITY: the PowerShell profile does the same.
if ($env.TERM? == "wezterm") { $env.TERM = "xterm-256color" }
# A blinking bar, as WezTerm's default_cursor_style: reedline sets the shape at every prompt,
# so a steady one ("line") here would stop the cursor blinking in Nushell tabs.
$env.config.cursor_shape.emacs = "blink_line"
# Deletes go to the Recycle Bin; `rm --permanent` skips it.
$env.config.rm.always_trash = true
# Fuzzy, case-insensitive matching in the completion menu (gco -> git checkout).
$env.config.completions.algorithm = "fuzzy"
# History in SQLite, not the plaintext file: every tab sees the others' commands as they
# run (the plaintext file is read once, at startup), and `history --long` keeps each
# command's cwd, duration and exit code. atuin owns Ctrl-R either way; this is Up/Down and
# `history`. The store starts empty: the plaintext history is in atuin (nu-init imported it).
$env.config.history.file_format = "sqlite"
# A table's datetimes (ls's modified column) as `ll` prints them (--time-style=long-iso),
# not "2 hours ago".
$env.config.datetime_format.table = "%Y-%m-%d %H:%M"

# Tab opens an IDE-style menu at the cursor, with carapace's description of each
# candidate beside it (zsh's fzf-tab shows the same), in Catppuccin Mocha with the
# mauve accent. Nushell's own completion_menu stays on its defaults for anything else.
$env.config.menus = ($env.config.menus | append {
    name: ide_completion_menu
    only_buffer_difference: false
    marker: ""
    type: {
        layout: ide
        min_completion_width: 0
        max_completion_width: 50
        max_completion_height: 10
        padding: 0
        border: true
        cursor_offset: 0
        description_mode: "prefer_right"
        min_description_width: 15
        max_description_width: 50
        max_description_height: 10
        description_offset: 1
        correct_cursor_pos: false
    }
    style: {
        text: "#cdd6f4"
        selected_text: { fg: "#1e1e2e" bg: "#cba6f7" }
        description_text: "#7f849c"
        match_text: { fg: "#cba6f7" attr: u }
        selected_match_text: { fg: "#1e1e2e" bg: "#cba6f7" attr: u }
    }
})

# Tables: icons beside paths (ls), as eza draws them; wide terminals expand nested data.
$env.config.hooks.display_output = "if (term size).columns >= 100 { table --expand --icons } else { table --icons }"

# --- fzf: the zsh side's look and file list ---------------------------------
$env.FZF_DEFAULT_OPTS = "--height 40% --layout=reverse --border --info=inline --bind=ctrl-/:toggle-preview --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8 --color=selected-bg:#45475a,border:#6c7086,label:#cdd6f4"
$env.FZF_DEFAULT_COMMAND = 'rg --files --hidden --follow --glob "!.git"'

# Ctrl-T inserts a picked file at the cursor; Alt-C cds into a picked directory
# (`fzf --nushell`, since fzf 0.73, would also take Ctrl-R, which is atuin's here).
# Esc in the picker changes nothing. Ctrl-R (atuin) and z/zi (zoxide) come from vendor/autoload. Tab opens the
# IDE menu above; Alt-. inserts the previous command's last word, as in zsh and bash
# (Nushell's own `!$` example runs the line when no space precedes it).
$env.config.keybindings = ($env.config.keybindings | append [
    {
        name: ide_completion
        modifier: none
        keycode: tab
        mode: [emacs vi_insert vi_normal]
        event: {
            until: [
                { send: menu name: ide_completion_menu }
                { send: menunext }
                { edit: complete }
            ]
        }
    }
    {
        name: last_argument
        modifier: alt
        keycode: char_.
        mode: [emacs vi_insert]
        event: {
            send: executehostcommand
            cmd: "commandline edit --insert (history | last 1 | get command.0? | default '' | split row ' ' | last)"
        }
    }
    {
        name: fzf_file
        modifier: control
        keycode: char_t
        mode: [emacs vi_insert vi_normal]
        event: {
            send: executehostcommand
            cmd: r#'let f = (fd --type f --hidden --exclude .git | fzf --preview "bat --color=always --style=numbers --line-range=:200 {}" | str trim); if ($f | is-not-empty) { commandline edit --insert ($f | to nuon) }'#
        }
    }
    {
        name: fzf_cd
        modifier: alt
        keycode: char_c
        mode: [emacs vi_insert vi_normal]
        event: {
            send: executehostcommand
            cmd: r#'let d = (fd --type d --hidden --exclude .git | fzf --preview "eza --tree --level=1 --icons=always --color=always {}" | str trim); if ($d | is-not-empty) { cd $d }'#
        }
    }
])

# --- Windows Terminal and WezTerm shell integration ------------------------
# Nushell already emits the OSC 133 prompt marks WT renders on the scrollbar
# (shell_integration.osc133 defaults true) and, on Windows, the OSC 9;9 cwd that
# lets duplicate-tab/split reopen the current directory (osc9_9, on by default
# since 0.105). The hooks add ConEmu OSC 9;4 taskbar progress (indeterminate while a curated
# long-runner executes; cleared at the next prompt — the same curated list as
# the zsh side: make/mise/wsa/wsu/dnf/cargo/npm/uv + git push/pull/fetch/clone);
# WezTerm (nightly) draws it as a tab spinner. WezTerm reads the cwd from OSC 7, not 9;9
# (which it ignores), so it gets an OSC 7 at every prompt as well.
# Gated on WT_SESSION / TERM_PROGRAM so nothing is emitted under any other terminal.
# Escapes: nu has no \a — use \u{1b} (ESC) and \u{07} (BEL).
# PRE-1.0 CHURN: hooks + shell_integration are churn surfaces — re-check on
# every Nushell pin bump (see CLAUDE.md).
# PARITY NOTE: reedline/Nushell-specific — the PowerShell profile's parity
# obligation with this file covers the ws*/g* aliases only, not these hooks.
if "WT_SESSION" in $env or ($env.TERM_PROGRAM? == "WezTerm") {
    $env.config.hooks.pre_execution = (
        $env.config.hooks.pre_execution? | default [] | append {||
            let cmd = (commandline | str trim)
            let simple = ($cmd | parse -r '^(?:make|mise|wsa|wsu|dnf|cargo|npm|uv)(?:\s|$)' | is-not-empty)
            let git_net = ($cmd | parse -r '^git\s+(?:push|pull|fetch|clone)(?:\s|$)' | is-not-empty)
            if ($simple or $git_net) {
                print -n "\u{1b}]9;4;3;0\u{07}"
            }
        }
    )

    $env.config.hooks.pre_prompt = (
        $env.config.hooks.pre_prompt? | default [] | append {||
            print -n "\u{1b}]9;4;0;0\u{07}"
        }
    )
}
# OSC 7 as WezTerm documents it for Windows shells: file://<host>/C:/path.
if ($env.TERM_PROGRAM? == "WezTerm") {
    $env.config.hooks.pre_prompt = (
        $env.config.hooks.pre_prompt? | default [] | append {||
            print -n $"\u{1b}]7;file://($env.COMPUTERNAME? | default '')/($env.PWD | str replace --all '\' '/')\u{1b}\\"
        }
    )
}

# --- Command not found ------------------------------------------------------
# A missing command asks mise whether it installs it (one mise start, on that error only).
# A tool mise installed but this session's PATH lacks wants a new tab or `mise reshim`; a
# mise older than config.toml's min_version refuses this config and every shim with it
# (README: a mise version bump reaches Windows through wsu's pull; re-run bootstrap.ps1).
$env.config.hooks.command_not_found = {|cmd|
    if (which mise | is-empty) { return null }
    let r = (do { ^mise -C $env.USERPROFILE which $cmd } | complete)
    if $r.exit_code == 0 {
        $"mise installs ($cmd) at ($r.stdout | str trim), but it isn't on this session's PATH: open a new tab, or run `mise reshim`."
    } else if ($r.stderr | str contains "min_version") {
        "mise is older than config.toml's min_version, so it refuses this config and its shims: re-run .\\bootstrap.ps1 from Windows PowerShell."
    } else {
        null
    }
}

# --- workstation commands (mise dotfiles; mirror the PowerShell profile) ----
# Every ws* command pins `-C $env.USERPROFILE`: mise resolves its config root
# by walking UP from the current directory, and this checkout IS
# %USERPROFILE%\.config\mise -- so an unpinned ws* run from any directory
# whose ancestors contain their own .config\mise (a second checkout, or --
# under WSL -- the Linux checkout reached via \\wsl$\...) silently manages the
# WRONG checkout instead of erroring. Confirmed live on this same class of
# bug on Linux: an unpinned `wsa` run from a Windows drive mount rewrote
# ~/.zshrc/~/.bashrc from a stale clone and made seven dotfiles executable.
# wse, wsd and wss are defs (wsr stays an alias): Tab on wse and wsd offers the tracked
# targets, and wss returns a table to filter (`wss | where state == differs`); any argument
# to wss goes to mise's own text output instead (`wss --json`). ws-targets and wss read the
# JSON wsa reads (one mise start). --wrapped hands mise's flags through (wse --apply).
# PARITY: the PowerShell wss returns the same columns as objects.
def ws-targets [] {
    try { mise -C $env.USERPROFILE dot status --json | from json | get files.target } catch { [] }
}
def --wrapped wse [...args: string@ws-targets] { mise -C $env.USERPROFILE dot edit ...$args }
def --wrapped wsd [...args: string@ws-targets] { mise -C $env.USERPROFILE dot diff ...$args }
def --wrapped wss [...args: string] {
    if ($args | is-empty) {
        mise -C $env.USERPROFILE dot status --json | from json | get files | select target mode state
    } else {
        mise -C $env.USERPROFILE dot status ...$args
    }
}
alias wsr = mise -C $env.USERPROFILE dot add --changed
# wsa is a def (below) — it checks for un-recorded drift before applying,
# since copy mode has no built-in prompt. Every [dotfiles] entry is `copy` or
# `template`, so a live edit under $HOME doesn't reach this checkout on its own,
# and an apply overwrites an un-recorded live edit with zero diff and zero warning. `differs` (NOT
# `missing` — a host's first-ever apply is expected to be all-missing) means
# $HOME has an edit `wsr`/`mise dot add <path>` hasn't captured yet.
#
# Belt and braces on top of the -C pin above: $status.files.0.origin
# .config_root names the config root mise actually resolved. If it isn't
# exactly $env.USERPROFILE, refuse instead of applying -- this catches the
# pin ever silently failing (a future mise -C semantics change, a stray env
# var) without re-deriving the pin's own logic. If the probe can't find that
# field at all (empty/unexpected JSON shape), PROCEED -- a guard that
# false-positives on a healthy host is worse than no guard.
def wsa [...args] {
    let status = (mise -C $env.USERPROFILE dot status --json | from json)
    let resolved_root = (try { $status.files.0.origin.config_root } catch { "" })
    if ($resolved_root != "") and ($resolved_root != $env.USERPROFILE) {
        print -e $"wsa: refusing -- mise resolved the dotfiles config root as '($resolved_root)', expected '($env.USERPROFILE)'. This would apply the WRONG checkout. Not proceeding; investigate the -C pin before retrying."
        return
    }
    let drifted = ($status.files | where state == "differs" | get target)
    if ($drifted | is-not-empty) {
        print -e "wsa: local edit(s) below differ from the repo and would be overwritten:"
        $drifted | each {|t| print -e $"  ($t)" }
        print -e ""
        mise -C $env.USERPROFILE dot diff -- ...$drifted
        # Parity with the bash/zsh `wsa` ([ -t 0 ] && [ -r /dev/tty ]): with no
        # console attached, `input` cannot prompt, so refuse rather than hang.
        if not (is-terminal --stdin) {
            print -e "wsa: refusing to overwrite non-interactively -- inspect with 'mise dot diff', record with wsr (or 'mise dot add <path>' for a directory entry), or re-run in a console."
            return
        }
        let reply = (input "Apply anyway and overwrite the edit(s) above? [y/N] ")
        if not ($reply | str downcase | str starts-with "y") {
            print -e "wsa: aborted -- nothing applied. Record the edit(s) first: wsr (a file entry), or 'mise dot add <path>' for a directory entry (e.g. ~/.claude/agents, ~/.claude/commands -- wsr's --changed skips those) -- then re-run wsa."
            return
        }
    }
    mise -C $env.USERPROFILE bootstrap --only dotfiles --yes ...$args
}
# `mise run update` is tasks/update, a
# #!/usr/bin/env bash script that calls `systemctl --user` and ends in an
# unscoped `mise bootstrap --yes` -- none of that runs on Windows. Do the
# Windows-safe equivalent directly: fast-forward pull, then the same
# `--only dotfiles,tools` scope bootstrap.ps1 itself uses. The git pull is
# already pinned via -C $env.WORKSTATION_REPO (a fixed path, not cwd-derived)
# -- only the mise bootstrap call needed the -C fix. --prune drops the
# origin/* branches GitHub no longer has (a merged PR's).
def wsu [...args] {
    git -C $env.WORKSTATION_REPO pull --ff-only --prune
    if $env.LAST_EXIT_CODE == 0 {
        mise -C $env.USERPROFILE bootstrap --only dotfiles,tools --yes ...$args
    }
}
# ws -- the workstation palette (`ws [words]`), dotfile reconciliation (`ws reconcile`) and
# project workspaces (`ws open [project]`): scripts\ws\ws.py on mise's Python, the same
# program as the bash/zsh ws. Windows has no zellij, so `ws open` changes this shell to the
# project (--tab opens a WezTerm or Windows Terminal tab there). A child process can't change
# this shell, so it hands back a `cd`, or a command to put on the prompt (a def such as wsa),
# in the WS_OUT file. PARITY: the PowerShell profile's ws.
def ws-python [] {
    try { ^mise -C $env.USERPROFILE which python | str trim } catch { "" }
}
def ws-complete [context: string] {
    let py = (ws-python)
    if ($py | is-empty) { return [] }
    let words = ($context | split row " " | skip 1)
    try { ^$py ($env.WORKSTATION_REPO | path join scripts ws ws.py) complete ...$words | lines } catch { [] }
}
def --env --wrapped ws [...args: string@ws-complete] {
    let py = (ws-python)
    if ($py | is-empty) {
        print -e "ws: mise's Python isn't installed yet (wsu installs it)"
        return
    }
    let out = (mktemp -t ws-out.XXXXXX)
    with-env { WS_OUT: $out, WS_SHELL: "nu" } {
        ^$py ($env.WORKSTATION_REPO | path join scripts ws ws.py) ...$args
    }
    let todo = (open --raw $out | lines | each {|l| $l | split row -n 2 (char tab) })
    rm -f $out
    for t in $todo {
        if ($t.0 == "cd") { cd $t.1 }
        # The next prompt starts with it: Enter runs it (checked on 0.113.1 under a pty).
        if ($t.0 == "insert") { commandline edit --replace $t.1 }
    }
}
# wsh -- the workstation cheatsheet, printed from scripts\ws\actions.toml (the catalogue
# `ws` searches; the bash/zsh and PowerShell wsh print the same, per shell).
def wsh [] { ws help }

# --- git aliases ------------------------------------------------------------
alias gs  = git status
alias ga  = git add
alias gc  = git commit
alias gp  = git push
alias gl  = git log --oneline --graph --decorate
alias gd  = git diff
alias gco = git checkout
alias gbr = git branch

# --- eza listings + yazi (mirror the zsh aliases and the PowerShell profile) --
# Plain `ls` stays Nushell's structured table (filter it: ls | where size > 1mb).
alias l = eza --group-directories-first --icons=auto --hyperlink
alias la = eza -a --group-directories-first --icons=auto --hyperlink
alias ll = eza -lah --group-directories-first --icons=auto --git --time-style=long-iso --hyperlink
alias lt = eza --tree --level=2 --group-directories-first --icons=auto --hyperlink
alias lta = eza --tree --level=2 -a --git-ignore --group-directories-first --icons=auto --hyperlink
alias ltl = eza --tree --level=2 -lh --git --group-directories-first --icons=auto --time-style=long-iso --hyperlink

# yazi: `y` opens it; on quit, cd to wherever you ended up.
def --env y [...args] {
    let tmp = (mktemp -t "yazi-cwd.XXXXXX")
    yazi ...$args --cwd-file $tmp
    let cwd = (open --raw $tmp | str trim)
    if $cwd != "" and $cwd != $env.PWD { cd $cwd }
    rm --permanent --force $tmp
}

# --- Screen clearing --------------------------------------------------------
# Nushell's built-in `clear` already wipes the scrollback. `hide` is the soft
# variant — clear the screen but KEEP the scrollback history (scroll up to see
# it). Mirrors the bash/zsh `hide`.
alias hide = clear --keep-scrollback

# --- Navigation -------------------------------------------------------------
# No aliases needed: Nushell has `..`, `...`, `....` (and deeper) built in as
# parent-directory shortcuts, so the bash/PowerShell `..`/`...` helpers are
# already covered natively.

# --- workstation helpers ----------------------------------------------------
# Quick path to the workstation repo. Defaults to bootstrap.ps1's clone path;
# override in a %APPDATA%\nushell\autoload\*.nu file if you cloned elsewhere.
$env.WORKSTATION_REPO = ($env.USERPROFILE | path join ".config" "mise")

# ssh-copy-id — Windows OpenSSH has none; port of the PowerShell profile helper.
# Picks a ~/.ssh/*.pub (prompts if several), confirms, then appends it to the
# target's authorized_keys over ssh.
def ssh-copy-id [target: string] {
    # Build the path from $USERPROFILE and list+filter rather than glob, to dodge
    # glob's backslash-as-escape and tilde-expansion ambiguities on Windows.
    let ssh_dir = ($env.USERPROFILE | path join ".ssh")
    let pubs = (if ($ssh_dir | path exists) { ls $ssh_dir | where name =~ '\.pub$' | get name } else { [] })
    if ($pubs | is-empty) {
        error make { msg: $"No public keys found in ($ssh_dir)" }
    }
    let key = if (($pubs | length) == 1) {
        $pubs | first
    } else {
        print "Available public keys:"
        $pubs | enumerate | each {|e| print $"[($e.index + 1)] ($e.item)" } | ignore
        let choice = (input "Select key number [1]: ")
        # Non-numeric -> 0 so it fails the range check below, mirroring the
        # PowerShell profile's "Invalid selection" guard.
        let idx = (if ($choice | is-empty) { 1 } else { try { $choice | into int } catch { 0 } })
        if ($idx < 1 or $idx > ($pubs | length)) {
            error make { msg: $"Invalid selection: ($choice)" }
        }
        $pubs | get ($idx - 1)
    }
    print $"Using key: ($key)"
    let confirm = (input $"Copy this key to ($target)? [Y/n] ")
    if ($confirm | str downcase | str starts-with "n") {
        print "Cancelled."
        return
    }
    open --raw $key | ssh $target "umask 077; mkdir -p ~/.ssh && cat >> ~/.ssh/authorized_keys"
}

# fssh — pick a Host from ~/.ssh/config with fzf, then ssh to it (zsh's fssh). The files its
# Include lines name are read too (relative to ~/.ssh, as ssh resolves them; the per-machine
# hosts live in config.local); glob patterns aren't followed. Host patterns (*, ?, !) are
# left out, and a `Host a b` line gives both names.
def fssh [] {
    let dir = ($env.USERPROFILE | path join ".ssh")
    let cfg = ($dir | path join "config")
    if not ($cfg | path exists) { return }
    let main = (open --raw $cfg | decode utf-8)
    let included = ($main | lines | parse --regex '^\s*Include\s+(?<f>.+?)\s*$' | get f
        | each {|l| $l | split row --regex '\s+' } | flatten
        | each {|f| if ($f =~ '^(~|/|[A-Za-z]:)') { $f | path expand } else { $dir | path join $f } }
        | where {|p| $p | path exists }
        | each {|p| open --raw $p | decode utf-8 })
    let hosts = ([$main] | append $included | str join "\n" | lines
        | parse --regex '^\s*Host\s+(?<h>.+?)\s*$' | get h
        | each {|l| $l | split row --regex '\s+' } | flatten
        | where {|h| $h !~ '[*?!]' } | uniq)
    # Esc in fzf exits non-zero, which Nushell (pipefail since 0.111) would raise.
    let host = (try { $hosts | str join "\n" | fzf | str trim } catch { "" })
    if ($host | is-not-empty) { ssh $host }
}

# adminpw — LAPS lookup lives in the PowerShell profile (needs the AdmPwd.PS
# .NET module), so delegate to PowerShell rather than reimplement it in nu. It
# copies the password to the clipboard (system-wide, so it survives the child
# process) and prints only the machine + expiry.
def adminpw [] {
    powershell -Command "Get-AdminPassword"
}

# --- External completions -----------------------------------------------------
# Tab on an external command: bootstrap.ps1's flags first (Nushell can't read a
# .ps1 param() block), then carapace (git, mise, winget, gh, ssh and ~1000 more),
# then Nushell's own file completion when both return null. The flag record mirrors
# bootstrap.ps1's param() block; check-invariants.sh's flag-parity check parses its
# `let`/closing-bracket lines, so keep them at column 0. carapace runs only on Tab.
# PRE-1.0 CHURN: the external-completer API is a churn surface; CI evaluates this
# file with the pinned nu (check-templates.sh), so a bump that breaks it fails CI.

let workstation_bootstrap_flags = [
    { value: "-RepoPath", description: "alternate clone path (default %USERPROFILE%\\.config\\mise)" }
    { value: "-SkipKeyGen", description: "skip the SSH-key prompt" }
    { value: "-SkipToolInstall", description: "skip mise, the mise tools, the winget GUI apps, the Python env and Claude Code" }
    { value: "-SkipDotfiles", description: "clone + install but don't deploy dotfiles" }
    { value: "-SkipBurntToast", description: "skip the BurntToast notification module" }
    { value: "-SkipNerdFonts", description: "skip the JetBrainsMono Nerd Font install" }
    { value: "-SkipElevated", description: "skip the UAC-prompting SSHFS-Win/WinFsp install" }
    { value: "-Reinstall", description: "wipe the cloned repo (incl. config.local.toml), bootstrap fresh" }
    { value: "-Yes", description: "skip the reinstall confirmation prompt" }
]

# carapace's own completer (its `_carapace nushell` snippet), except that an alias completes
# as its whole expansion (gco ma -> git checkout ma, so Tab offers branches) where carapace's
# snippet keeps the first word only. Windows' .exe suffix is dropped from the command.
let carapace_completer = {|spans|
    if (which carapace | is-empty) { return null }
    let expanded_alias = (scope aliases | where name == $spans.0 | $in.0?.expansion?)
    let words = (if $expanded_alias != null {
        $expanded_alias | split row --regex '\s+' | where {|w| $w != "" }
    } else {
        [$spans.0]
    })
    let spans = ($spans | skip 1 | prepend ($words | skip 1) | prepend ($words.0 | str replace --regex '\.exe$' ''))
    if ($spans | length) == 1 { return null }
    with-env { CARAPACE_SHELL: "nushell" } { carapace $spans.0 nushell ...$spans | from json }
}

$env.config.completions.external = {
    enable: true
    max_results: 100
    completer: {|spans|
        if ($spans | first | path basename | str downcase) == "bootstrap.ps1" {
            let word = ($spans | last | str downcase)
            let matches = ($workstation_bootstrap_flags | where {|f| $f.value | str downcase | str starts-with $word })
            if ($matches | is-empty) { null } else { $matches }
        } else {
            do $carapace_completer $spans
        }
    }
}
