# =============================================================================
# config.nu — Nushell config, managed by mise dotfiles
# Machine: {{ env.COMPUTERNAME | default(value="") }} | User: {{ env.USERNAME | default(value="") }}
#
# Deploys to %APPDATA%\nushell\config.nu (Windows only — the whole AppData tree
# is declared only in config.windows.toml, never gated for Linux). Nushell is the default LOCAL Windows
# shell (the Windows Terminal "Nushell" profile); PowerShell stays installed
# for .NET/COM tasks and the WSL2 notify hook.
#
# This file owns the HAND-WRITTEN config (aliases, env, helpers). Two things are
# wired separately by GENERATED files under %APPDATA%\nushell\vendor\autoload\
# (everything there is auto-sourced on startup, so no `source` lines here):
# starship.nu (the prompt — bootstrap.ps1's Invoke-NushellStarship) and mise.nu
# (`mise activate nu` — Invoke-NushellMise; puts the mise-managed node/Go/uv/
# LSP servers on PATH ahead of the shims dir).
#
# PARITY NOTE: the ws*/g* aliases below mirror the PowerShell profile
# (Documents/PowerShell/Microsoft.PowerShell_profile.ps1.tera). Keep the two in
# sync when adding or renaming an alias so both Windows shells behave the same.
#
# Per-machine overrides (untracked): drop a `*.nu` file into
# %APPDATA%\nushell\vendor\autoload\ — it is auto-sourced after this file.
# =============================================================================

# --- Shell behaviour --------------------------------------------------------
# Mutate fields on the pre-populated default $env.config (never reassign the
# whole record — that would wipe Nushell's defaults).
$env.config.show_banner = false

# --- Windows Terminal shell integration --------------------------------------
# Nushell already emits the OSC 133 prompt marks WT renders on the scrollbar
# (shell_integration.osc133 defaults true) — zero config needed for marks. Two
# added halves: osc9_9 reports the cwd so duplicate-tab/split reopens the
# current directory (native Windows paths — no translation needed), and the
# hooks emit ConEmu OSC 9;4 taskbar progress (indeterminate while a curated
# long-runner executes; cleared at the next prompt — the same curated list as
# the zsh side: make/mise/wsa/wsu/dnf/cargo/npm/uv + git push/pull/fetch/clone).
# Gated on WT_SESSION so nothing is emitted under any other host terminal.
# Escapes: nu has no \a — use \u{1b} (ESC) and \u{07} (BEL).
# PRE-1.0 CHURN: hooks + shell_integration are churn surfaces — re-check on
# every Nushell pin bump (see CLAUDE.md).
# PARITY NOTE: reedline/Nushell-specific — the PowerShell profile's parity
# obligation with this file covers the ws*/g* aliases only, not these hooks.
if "WT_SESSION" in $env {
    $env.config.shell_integration.osc9_9 = true

    $env.config.hooks.pre_execution = (
        $env.config.hooks.pre_execution? | default [] | append {||
            let cmd = (commandline | str trim)
            let simple = ($cmd | parse -r '^(?:make|mise|wsa|wsu|dnf|cargo|npm|uv)(?:\s|$)' | is-not-empty)
            let git_net = ($cmd | parse -r '^git\s+(?:push|pull|fetch|clone)(?:\s|$)' | is-not-empty)
            if ($simple or $git_net) {
                print -n "\u{1b}]9;4;3;0\u{07}"
            }
        }
    )

    $env.config.hooks.pre_prompt = (
        $env.config.hooks.pre_prompt? | default [] | append {||
            print -n "\u{1b}]9;4;0;0\u{07}"
        }
    )
}

# --- workstation aliases (mise dotfiles; mirror the PowerShell profile) -----
# Every ws* command pins `-C $env.USERPROFILE`: mise resolves its config root
# by walking UP from the current directory, and this checkout IS
# %USERPROFILE%\.config\mise -- so an unpinned ws* run from any directory
# whose ancestors contain their own .config\mise (a second checkout, or --
# under WSL -- the Linux checkout reached via \\wsl$\...) silently manages the
# WRONG checkout instead of erroring. Confirmed live on this same class of
# bug on Linux: an unpinned `wsa` run from a Windows drive mount rewrote
# ~/.zshrc/~/.bashrc from a stale clone and made seven dotfiles executable.
alias wse = mise -C $env.USERPROFILE dot edit
alias wsd = mise -C $env.USERPROFILE dot diff
alias wss = mise -C $env.USERPROFILE dot status
alias wsr = mise -C $env.USERPROFILE dot add --changed
# wsa is a def (below) — it checks for un-recorded drift before applying,
# since copy mode has no chezmoi-style prompt of its own. Every [dotfiles]
# entry is `copy` (or `template`) now — a live edit under $HOME no longer
# round-trips implicitly, and copy-mode apply otherwise overwrites an
# un-recorded live edit with zero diff and zero warning. `differs` (NOT
# `missing` — a host's first-ever apply is expected to be all-missing) means
# $HOME has an edit `wsr`/`mise dot add <path>` hasn't captured yet.
#
# Belt and braces on top of the -C pin above: $status.files.0.origin
# .config_root names the config root mise actually resolved. If it isn't
# exactly $env.USERPROFILE, refuse instead of applying -- this catches the
# pin ever silently failing (a future mise -C semantics change, a stray env
# var) without re-deriving the pin's own logic. If the probe can't find that
# field at all (empty/unexpected JSON shape), PROCEED -- a guard that
# false-positives on a healthy host is worse than no guard.
def wsa [...args] {
    let status = (mise -C $env.USERPROFILE dot status --json | from json)
    let resolved_root = (try { $status.files.0.origin.config_root } catch { "" })
    if ($resolved_root != "") and ($resolved_root != $env.USERPROFILE) {
        print -e $"wsa: refusing -- mise resolved the dotfiles config root as '($resolved_root)', expected '($env.USERPROFILE)'. This would apply the WRONG checkout. Not proceeding; investigate the -C pin before retrying."
        return
    }
    let drifted = ($status.files | where state == "differs" | get target)
    if ($drifted | is-not-empty) {
        print -e "wsa: local edit(s) below differ from the repo and would be overwritten:"
        $drifted | each {|t| print -e $"  ($t)" }
        print -e ""
        mise -C $env.USERPROFILE dot diff -- ...$drifted
        # Parity with the bash/zsh `wsa` ([ -t 0 ] && [ -r /dev/tty ]): with no
        # console attached, `input` cannot prompt, so refuse rather than hang.
        if not (is-terminal --stdin) {
            print -e "wsa: refusing to overwrite non-interactively -- inspect with 'mise dot diff', record with wsr (or 'mise dot add <path>' for a directory entry), or re-run in a console."
            return
        }
        let reply = (input "Apply anyway and overwrite the edit(s) above? [y/N] ")
        if not ($reply | str downcase | str starts-with "y") {
            print -e "wsa: aborted -- nothing applied. Record the edit(s) first: wsr (a file entry), or 'mise dot add <path>' for a directory entry (e.g. ~/.claude/agents, ~/.claude/commands -- wsr's --changed skips those) -- then re-run wsa."
            return
        }
    }
    mise -C $env.USERPROFILE bootstrap --only dotfiles --yes ...$args
}
# I8 fix (final-fix-brief.md): `mise run update` is tasks/update, a
# #!/usr/bin/env bash script that calls `systemctl --user` and ends in an
# unscoped `mise bootstrap --yes` -- none of that runs on Windows. Do the
# Windows-safe equivalent directly: fast-forward pull, then the same
# `--only dotfiles,tools` scope bootstrap.ps1 itself uses. The git pull is
# already pinned via -C $env.WORKSTATION_REPO (a fixed path, not cwd-derived)
# -- only the mise bootstrap call needed the -C fix.
def wsu [...args] {
    git -C $env.WORKSTATION_REPO pull --ff-only
    if $env.LAST_EXIT_CODE == 0 {
        mise -C $env.USERPROFILE bootstrap --only dotfiles,tools --yes ...$args
    }
}
# wsh -- workstation cheatsheet, the Windows twin of the bash/zsh wsh (and
# of the PowerShell profile's). Same ASCII text as the PowerShell one apart
# from the -C pin's spelling and the override line's wording. Only the ~/.claude/* directory entries load on
# Windows (config.dev.toml); the Linux-only ones (zellij, zsh completions,
# gdb, ~/.local/bin) don't. Nushell has no per-machine override file.
def wsh [] {
    # str trim: drop the newlines just inside the raw string's delimiters, so
    # the output matches the PowerShell here-string (no leading blank line).
    print (r#'
workstation commands (mise dotfiles). Each one acts on this host's own
checkout at ~\.config\mise, whatever the current directory (every ws*
command pins `mise -C $env.USERPROFILE`):
  wse  mise dot edit <path>     edit a tracked file's source
  wsd  mise dot diff            preview pending changes to ~
  wsa  apply; warns and asks first if ~ has an unrecorded local edit
  wsr  mise dot add --changed   record FILE-entry edits back to the source
       (a DIRECTORY entry -- ~/.claude/agents, ~/.claude/commands,
       ~/.claude/hooks, ~/.claude/skills -- needs `mise dot add <that
       directory>` instead; --changed skips directory copies)
  wss  mise dot status          list managed files and their state
  wsu  git pull + mise bootstrap --only dotfiles,tools
       (portable tools such as gh, opencode and omp come from
       bootstrap.ps1: run .\bootstrap.ps1 when their pins change)
  wsh  this help

Common flow:
  wse ~/.config/starship.toml   (edit the source)
  wsd                           (preview the change)
  wsa                           (apply to ~)

When an app edits a deployed file itself (Zed, Warp or Windows Terminal
saving their settings, or Claude Code editing ~/.claude/CLAUDE.md):
  wsr                             (file entries)
  mise dot add ~/.claude/agents   (a directory entry, by exact target path)
  wsa                             (now a no-op for what you just recorded)

Push tracked changes upstream:
  cd ~\.config\mise; git add -A; git commit -m '...'; git push

Per-machine overrides (untracked):
  Microsoft.PowerShell_profile.local.ps1 next to the PS profile   (PowerShell)
  ~/.ssh/config.local                                             (ssh)
'# | str trim)
}

# --- git aliases ------------------------------------------------------------
alias gs  = git status
alias ga  = git add
alias gc  = git commit
alias gp  = git push
alias gl  = git log --oneline --graph --decorate
alias gd  = git diff
alias gco = git checkout
alias gbr = git branch

# --- Screen clearing --------------------------------------------------------
# Nushell's built-in `clear` already wipes the scrollback. `hide` is the soft
# variant — clear the screen but KEEP the scrollback history (scroll up to see
# it). Mirrors the bash/zsh `hide`.
alias hide = clear --keep-scrollback

# --- Navigation -------------------------------------------------------------
# No aliases needed: Nushell has `..`, `...`, `....` (and deeper) built in as
# parent-directory shortcuts, so the bash/PowerShell `..`/`...` helpers are
# already covered natively.

# --- workstation helpers ----------------------------------------------------
# Quick path to the workstation repo. Defaults to bootstrap.ps1's clone path;
# override in a vendor/autoload/*.nu file if you cloned elsewhere.
$env.WORKSTATION_REPO = ($env.USERPROFILE | path join ".config" "mise")

# ssh-copy-id — Windows OpenSSH has none; port of the PowerShell profile helper.
# Picks a ~/.ssh/*.pub (prompts if several), confirms, then appends it to the
# target's authorized_keys over ssh.
def ssh-copy-id [target: string] {
    # Build the path from $USERPROFILE and list+filter rather than glob, to dodge
    # glob's backslash-as-escape and tilde-expansion ambiguities on Windows.
    let ssh_dir = ($env.USERPROFILE | path join ".ssh")
    let pubs = (if ($ssh_dir | path exists) { ls $ssh_dir | where name =~ '\.pub$' | get name } else { [] })
    if ($pubs | is-empty) {
        error make { msg: $"No public keys found in ($ssh_dir)" }
    }
    let key = if (($pubs | length) == 1) {
        $pubs | first
    } else {
        print "Available public keys:"
        $pubs | enumerate | each {|e| print $"[($e.index + 1)] ($e.item)" } | ignore
        let choice = (input "Select key number [1]: ")
        # Non-numeric -> 0 so it fails the range check below, mirroring the
        # PowerShell profile's "Invalid selection" guard.
        let idx = (if ($choice | is-empty) { 1 } else { try { $choice | into int } catch { 0 } })
        if ($idx < 1 or $idx > ($pubs | length)) {
            error make { msg: $"Invalid selection: ($choice)" }
        }
        $pubs | get ($idx - 1)
    }
    print $"Using key: ($key)"
    let confirm = (input $"Copy this key to ($target)? [Y/n] ")
    if ($confirm | str downcase | str starts-with "n") {
        print "Cancelled."
        return
    }
    open --raw $key | ssh $target "umask 077; mkdir -p ~/.ssh && cat >> ~/.ssh/authorized_keys"
}

# adminpw — LAPS lookup lives in the PowerShell profile (needs the AdmPwd.PS
# .NET module), so delegate to PowerShell rather than reimplement it in nu. It
# copies the password to the clipboard (system-wide, so it survives the child
# process) and prints only the machine + expiry.
def adminpw [] {
    powershell -Command "Get-AdminPassword"
}

# --- Repo-script flag completion (external completer) ------------------------
# Nushell only completes flags for commands with declared signatures; external
# commands (the repo's .ps1 scripts) otherwise fall back to file completion —
# the "NO RECORDS FOUND" menu. This external completer recognises the
# flag-bearing repo script BY BASENAME — `.\bootstrap.ps1` and a full path
# both match — and returns its flags with descriptions; anything else
# returns null -> Nushell's default file completion (behavior everywhere
# else is unchanged). The flag list mirrors the script's param() block and
# is kept in lockstep by check-invariants.sh's flag-parity check (which
# parses `let workstation_bootstrap_flags` — keep its `let`/closing-bracket
# lines at column 0). Classic PowerShell
# needs none of this: it tab-completes param() flags natively.
# PRE-1.0 CHURN: the external-completer API is a known churn surface —
# re-check this block on every Nushell pin bump (see CLAUDE.md).

let workstation_bootstrap_flags = [
    { value: "-RepoPath", description: "alternate clone path (default %USERPROFILE%\\.config\\mise)" }
    { value: "-SkipKeyGen", description: "skip the SSH-key prompt" }
    { value: "-SkipToolInstall", description: "skip portable tools, installer apps and Claude Code" }
    { value: "-SkipDotfiles", description: "clone + install but don't deploy dotfiles" }
    { value: "-SkipBurntToast", description: "skip the BurntToast notification module" }
    { value: "-SkipNerdFonts", description: "skip the JetBrainsMono Nerd Font install" }
    { value: "-ForceInstaller", description: "re-install installer apps even if present" }
    { value: "-SkipElevated", description: "skip the UAC-prompting SSHFS-Win/WinFsp install" }
    { value: "-Reinstall", description: "wipe the cloned repo + chezmoi config, bootstrap fresh" }
    { value: "-Yes", description: "skip the reinstall confirmation prompt" }
    { value: "-Doctor", description: "read-only health report, then exit" }
    { value: "-CheckForUpdates", description: "read-only update scan, then exit" }
]

$env.config.completions.external = {
    enable: true
    max_results: 100
    completer: {|spans|
        let cmd = ($spans | first | path basename | str downcase)
        let flags = if $cmd == "bootstrap.ps1" {
            $workstation_bootstrap_flags
        } else {
            null
        }
        if $flags == null {
            null
        } else {
            let word = ($spans | last | str downcase)
            let matches = ($flags | where {|f| $f.value | str downcase | str starts-with $word })
            if ($matches | is-empty) { null } else { $matches }
        }
    }
}
