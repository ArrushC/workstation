# Managed by mise dotfiles (workstation repo).
# Per-machine overrides go in ~/.ssh/config.local (un-tracked).
# Include must come FIRST — Host/Match are first-match-wins for most options.
Include config.local

Host *
    ServerAliveInterval 30
    ServerAliveCountMax 3
    TCPKeepAlive yes
    ConnectTimeout 10
{%- if os() != "windows" %}

    # Connection multiplexing — keep a TCP socket open for 60s after the
    # first ssh exits, so subsequent ssh/scp/rsync invocations to the
    # same host reuse it (no re-handshake, no re-auth). Equivalent to
    # what the old ansible.cfg set; now applies to scripts/update-hosts.sh
    # bulk updates AND interactive ssh.
    #
    # Linux/macOS only. Windows OpenSSH multiplexes over a handle that is
    # not a Winsock socket, so getsockname() returns WSAENOTSOCK
    # ("getsockname failed: Not a socket") and the session hangs until
    # ServerAlive trips ("Timeout, server <host> not responding."). The
    # block is gated out on Windows; native ssh there opens a fresh
    # connection per call. Per-host opt-out elsewhere: ControlPath none
    # in ~/.ssh/config.local (Included first, first-match-wins).
    ControlMaster auto
    ControlPersist 60s
    ControlPath ~/.ssh/cm-%r@%h:%p
{%- endif %}
