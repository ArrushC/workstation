#!/usr/bin/env bash
#MISE description="Install Neovim's plugins at nvim-pack-lock.json's commits, blink.cmp's matcher and the treesitter parsers (the final hook)"
set -euo pipefail
# Headless Neovim runs lua/ws/provision.lua from the deployed ~/.config/nvim:
# it installs missing plugins at the lockfile's commits, moves the others to
# them (after `wsu` pulled a new lockfile), fetches blink.cmp's prebuilt
# matcher and builds the treesitter parsers (tree-sitter CLI + the host's cc,
# else mise's zig; skipped, not failed, without either). Windows runs
# scripts/nvim-plugins.nu from its post-tools hook instead. Interactive Neovim never
# installs (lua/ws/plugins.lua explains why), so plugins arrive only here or
# by :PackInstall. Idempotent: a second run is a ~1 s no-op. A failure warns
# and exits 0 like the other final-hook tasks; re-run `mise run nvim-plugins`.
command -v nvim >/dev/null 2>&1 || exit 0
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/nvim"
if [ ! -f "$cfg/lua/ws/provision.lua" ]; then
  echo "  ! $cfg is not deployed yet (dotfiles not applied?) — skipped" >&2
  exit 0
fi
if timeout 1200 nvim --headless --cmd 'let g:ws_pack_install = 1' \
  -c "lua require('ws.provision').run()" 2>&1 |
  sed -u -e '/Installing parser$/d' -e '/Language installed$/d' -e '/Downloading tree-sitter-.*\.\.\.$/d' \
    -e '/Compiling parser$/d' -e '/^$/d' -e 's/^/  /'; then
  echo "  nvim: plugins, matcher and parsers ready"
else
  echo "  ! nvim plugins incomplete (offline?): re-run \`mise run nvim-plugins\`" >&2
fi
