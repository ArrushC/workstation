#!/usr/bin/env bash
#MISE description="post-dotfiles hook: record what each managed dotfile now agrees on, ws reconcile's baseline"
#MISE hide=true
# Runs after every dotfiles apply (wsa, wsu, bootstrap.sh, mise dot apply), from the
# post-dotfiles line in config.linux.toml. scripts/ws/wslib/baseline.py has the store.
# A hook must never stop a bootstrap: with no python3 yet, or one older than 3.11 (a fresh
# host, before the tools phase installs mise's), it says so and exits 0.
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
py=$(command -v python3) || {
  echo "ws baseline: no python3 yet: skipped" >&2
  exit 0
}
"$py" "$root/scripts/ws/ws.py" baseline record || true
