#!/usr/bin/env bash
#MISE description="Build the locked scripting environment; keep wpy/textual/typer launchers"
#USAGE flag "--rebuild" help="Build a fresh generation from the committed lock (does not upgrade dependencies)"
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
args=()
if [ "${usage_rebuild:-false}" = true ]; then args+=(--rebuild); fi
exec python3 "$root/scripts/tool-env.py" python "${args[@]}"
