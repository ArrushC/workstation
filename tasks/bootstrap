#!/usr/bin/env bash
#MISE description="End-of-bootstrap steps on every host: cheat sheets, zjstatus plugin, nb notebook, tldr cache (after python-env)"
#MISE depends=["python-env"]
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
state="${XDG_STATE_HOME:-$HOME/.local/state}/workstation"
# 1. cheat community cheatsheets. Cloned here rather than via [bootstrap.repos]
# because a failed clone must not abort provisioning: repos would run ahead of
# tools/services/this task, so an unreachable GitHub would take down the whole
# run for a cosmetic cheat-sheet checkout.
if command -v cheat >/dev/null 2>&1 && command -v git >/dev/null 2>&1 &&
  [ ! -d "$HOME/.config/cheat/cheatsheets/community" ]; then
  echo "==> cheat community cheatsheets"
  git clone --depth 1 https://github.com/cheat/cheatsheets \
    "$HOME/.config/cheat/cheatsheets/community" ||
    { echo "  ! cheat community clone failed — run manually: git clone --depth 1 https://github.com/cheat/cheatsheets $HOME/.config/cheat/cheatsheets/community" >&2; }
fi
# 2. zjstatus.wasm → zellij's DATA plugin dir (mise installs the tool; zellij loads plugins from its data dir, never a bin dir)
"$root/scripts/lib/zellij-plugin.sh" zjstatus "file://$(mise where github:dj95/zjstatus)/zjstatus.wasm"
# 3. nb notebook init at ~/notes, once.
# Marker-guarded: a missing nb or a
# failed/incomplete init must not abort the bootstrap, and must retry on the
# next run instead of giving up forever. nb's first-run wizard needs a real
# answer — read from /dev/tty (under `curl … | bash`, plain stdin is the
# piped script itself, not a terminal; when there's no controlling tty the
# redirect itself fails fast instead of hanging — the same pattern
# resolve_host_config() in bootstrap.sh uses for its own first-run prompts).
# Success is judged by the post-condition (~/notes exists), never by nb's
# own exit code — nb's wizard exits 0 on stdin EOF having created nothing
# (found while verifying this step in a scratch $HOME).
nb_marker="$state/nb-notebook"
if [ ! -f "$nb_marker" ]; then
  if command -v nb >/dev/null 2>&1; then
    if [ -d "$HOME/notes" ]; then
      mkdir -p "$state" && : >"$nb_marker" || true
    else
      echo "==> nb notebook (~/notes)"
      nb notebooks init home "$HOME/notes" </dev/tty || nb init </dev/tty || true
      if [ -d "$HOME/notes" ]; then
        mkdir -p "$state" && : >"$nb_marker" || true
      else
        echo "  ! nb notebook not created at ~/notes — run by hand: nb notebooks init ~/notes --name home" >&2
      fi
    fi
  else
    echo "  nb not found on PATH — skipping notebook init (retries next run)" >&2
  fi
fi
# 4. tldr page cache seed, once.
# Ongoing freshness after the first seed is auto_update in
# ~/.config/tealdeer/config.toml, not this step.
tldr_marker="$state/tldr-cache"
if [ ! -f "$tldr_marker" ]; then
  if command -v tldr >/dev/null 2>&1; then
    if [ -d "$HOME/.cache/tealdeer/tldr-pages" ]; then
      mkdir -p "$state" && : >"$tldr_marker" || true
    else
      echo "==> tldr cache seed"
      if tldr --update >/dev/null 2>&1; then
        mkdir -p "$state" && : >"$tldr_marker" || true
      else
        echo "  ! tldr --update failed (offline?) — auto_update will retry on first use" >&2
      fi
    fi
  else
    echo "  tldr not found on PATH — skipping cache seed (retries next run)" >&2
  fi
fi
