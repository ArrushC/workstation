#!/usr/bin/env bash
#MISE description="point git at .githooks/ so the pre-commit invariant check runs before every commit"
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck disable=SC2034  # part of the common task preamble; unused by this task
state="${XDG_STATE_HOME:-$HOME/.local/state}/workstation"
env_has() {
  case ",${MISE_ENV:-}," in *,"$1",*) return 0 ;; esac
  return 1
}
git -C "$root" config core.hooksPath .githooks
printf 'installed: git hooks now run from .githooks/ (pre-commit -> check-invariants.sh)\n'
printf 'bypass one commit with: git commit --no-verify\n'
