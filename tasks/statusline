#!/usr/bin/env bash
#MISE description="interactive ccstatusline setup prompt (dev only)"
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck disable=SC2034  # part of the common task preamble; unused by this task
state="${XDG_STATE_HOME:-$HOME/.local/state}/workstation"
env_has() {
  case ",${MISE_ENV:-}," in *,"$1",*) return 0 ;; esac
  return 1
}
if env_has owned; then
  exec "$root/scripts/setup-ccstatusline.sh"
else
  echo "statusline is an owned-host target — skipping (MISE_ENV=${MISE_ENV:-unset})"
fi
