#!/usr/bin/env bash
#MISE description="JetBrainsMono Nerd Font Mono into ~/.local/share/fonts (dev, non-WSL)"
#MISE env={NERD_FONT_VERSION="{{ vars.nerd_font_version }}"}
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
state="${XDG_STATE_HOME:-$HOME/.local/state}/workstation"
env_has() {
  case ",${MISE_ENV:-}," in *,"$1",*) return 0 ;; esac
  return 1
}
if ! env_has owned; then
  echo "  fonts: dev hosts only"
  exit 0
fi
if env_has wsl; then
  echo "  fonts: skipped on WSL — the Windows terminal resolves fonts"
  exit 0
fi
mkdir -p "$state"
stamp="$state/nerd-fonts-$NERD_FONT_VERSION.done"
if [ -f "$stamp" ] && [ -d "$HOME/.local/share/fonts/JetBrainsMonoNerdFontMono" ]; then
  echo "  nerd-fonts $NERD_FONT_VERSION already installed"
  exit 0
fi
"$root/scripts/lib/font.sh" "$HOME/.local/share/fonts" "$NERD_FONT_VERSION" "$stamp"
