#!/usr/bin/env bash
#MISE description="JetBrainsMono Nerd Font Mono into ~/.local/share/fonts from the mise font tool (owned hosts' final hook; skipped under WSL)"
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Under WSL the Windows terminal resolves fonts, so there is nothing to do. is_wsl is
# bootstrap.sh's, sourced in library mode so the detection lives in one place.
if WORKSTATION_BOOTSTRAP_LIB=1 bash -c 'source "$1"; is_wsl' _ "$root/bootstrap.sh"; then
  echo "  fonts skipped under WSL (the Windows terminal resolves fonts)"
  exit 0
fi
src="$(mise where github:ryanoasis/nerd-fonts)"
dest="$HOME/.local/share/fonts/JetBrainsMonoNerdFontMono"
mkdir -p "$dest"
changed=0
for s in Regular Italic Bold BoldItalic Medium MediumItalic; do
  f="JetBrainsMonoNerdFontMono-$s.ttf"
  if ! cmp -s "$src/$f" "$dest/$f"; then
    install -m 0644 "$src/$f" "$dest/$f"
    changed=1
  fi
done
if [ "$changed" = 1 ]; then
  if command -v fc-cache >/dev/null 2>&1; then fc-cache -f "$dest" >/dev/null; else echo "  ! fc-cache not on PATH — install fontconfig for font discovery" >&2; fi
  echo "  installed JetBrainsMono Nerd Font Mono into $dest"
else
  echo "  JetBrainsMono Nerd Font Mono up to date"
fi
