#!/usr/bin/env bash
#MISE description="One-time sweeps of pre-mise artifacts: PR1 tool installs (/usr/local/bin or ~/.local/bin, helix runtime, eget, tool stamps), PR2 host-state (legacy pueued unit, /usr/local vcpkg, PATH profile.d file, the old stamps dir), PR3 chezmoi retirement (chezmoi.toml, its boltdb cache, the pre-relocation ~/.local/share/chezmoi leftover)"
#MISE hide=true
# Three independent, marker-guarded sweeps below — PR1 (marker
# ~/.local/state/workstation/legacy-tools-swept) then PR2 (marker
# …/legacy-host-swept) then PR3 (marker …/legacy-chezmoi-swept). Each marker
# only skips ITS OWN sweep, never the others: a host that finished the PR1/
# PR2 sweeps before PR3 shipped must still run the PR3 sweep the first time
# this task sees the new code, so no check may `exit 0` — only guard its own
# block.
# sudo is used ONLY for /usr/local (+ /etc/profile.d) paths and ONLY when this
# host is a dev machine (MISE_ENV contains `host`, or the Make era's
# HAS_SUDO=true). Everything removed here is reinstalled by mise from
# config*.toml — nothing is unrecoverable.
# When there is no sudo on this host, /usr/local (+ /etc/profile.d) is skipped
# ENTIRELY (not just individual paths within it): the repo's prod scope never
# installed there, so a sudo-less host has nothing of its own to sweep, and
# any root-owned files it happens to find are not ours to remove — walking
# them would only ever report a permanent, unfixable failure and keep the
# marker withheld forever.
# Unattended runs (wsu over a non-interactive ssh) have no TTY, so a dev host whose sudo
# needs a password must never block on a prompt: a one-shot `sudo -n true`
# probe decides up front (once, shared by both sweeps below), and rm_p uses
# `sudo -n` too so a later, unrelated sudo timeout can't reintroduce a hang.
set -uo pipefail
state="${XDG_STATE_HOME:-$HOME/.local/state}/workstation"
marker="$state/legacy-tools-swept"
host_marker="$state/legacy-host-swept"
chezmoi_marker="$state/legacy-chezmoi-swept"
marker_done=false
if [ -f "$marker" ]; then
  echo "  legacy sweep already done ($marker)"
  marker_done=true
fi
use_sudo=false
case ",${MISE_ENV:-}," in *,host,*) use_sudo=true ;; esac
[ "${HAS_SUDO:-}" = true ] && use_sudo=true
failed=0
sudo_password_needed=false
# Probe only while a sudo-using sweep (PR1 or PR2) is still pending. Once
# both markers exist, a password-sudo dev host would otherwise print the
# "run ./bootstrap.sh --dev interactively to finish the sweep" warning on
# every wsu, for a sweep that has already finished.
if $use_sudo && { ! $marker_done || [ ! -f "$host_marker" ]; } && ! sudo -n true 2>/dev/null; then
  use_sudo=false
  sudo_password_needed=true
  printf '  ! sudo needs a password on this host — /usr/local left untouched; run ./bootstrap.sh --dev interactively once to finish the sweep\n'
  failed=$((failed + 1))
fi
rm_p() { # rm_p <path>… — rm -rf, via sudo only where the parent is not ours;
  # counts a failed-or-skipped removal in $failed so the caller can withhold
  # the idempotency marker instead of falsely claiming the sweep is done.
  local p
  for p in "$@"; do
    [ -e "$p" ] || [ -L "$p" ] || continue
    if [ -w "$(dirname "$p")" ]; then
      if rm -rf "$p"; then
        printf '  - removed %s\n' "$p"
      else
        printf '  ! failed to remove %s\n' "$p"
        failed=$((failed + 1))
      fi
    elif $use_sudo; then
      if sudo -n rm -rf "$p"; then
        printf '  - removed %s\n' "$p"
      else
        printf '  ! failed to remove %s\n' "$p"
        failed=$((failed + 1))
      fi
    else
      printf '  ! cannot remove %s (no sudo on this host) — remove by hand\n' "$p"
      failed=$((failed + 1))
    fi
  done
}
# Every binary the Make macros used to place in DEST (registered names → binaries).
names=(fzf zoxide starship zellij glow hx fd bat btop bandwhich lazydocker dive lnav gopass fastfetch
  gitui lazygit jj ast-grep sg tv fx gitlogue xh gping atuin delta micro eza sd k9s rclone croc hyperfine
  mise dsq gh htmlq ouch watchexec btm systemctl-tui rg mlr csvlens difft trip doggo scc git-absorb
  miniserve numbat qsv grex jless gitleaks procs dust hexyl gum rust-analyzer marksman taplo herdr
  opencode omp broot chezit cheat eget ncdu usql yazi ya nnn age age-keygen nb jq yq tldr witr ctop sops
  lazyjournal sysz ssh-copy-id shfmt pueue pueued nnd chezmoi cht.sh devtoys.cli pwndbg
  node npm npx corepack go gofmt uv uvx gopls lua-language-server typescript-language-server
  bash-language-server yaml-language-server vscode-json-language-server vscode-css-language-server
  vscode-html-language-server vscode-eslint-language-server vscode-markdown-language-server tsc tsserver)

if ! $marker_done; then
  dirs=("$HOME/.local/bin")
  if $use_sudo; then
    dirs=(/usr/local/bin "${dirs[@]}")
  elif ! $sudo_password_needed; then
    echo "  · no sudo on this host — /usr/local left untouched (prod hosts never received Make installs there)"
  fi
  for d in "${dirs[@]}"; do
    [ -d "$d" ] || continue
    # ~/.local/bin/mise is the NEW pinned mise (bootstrap.sh) — never remove it there.
    for n in "${names[@]}"; do
      [ "$d" = "$HOME/.local/bin" ] && [ "$n" = mise ] && continue
      rm_p "$d/$n"
    done
    rm_p "$d"/_pwndbg-* "$d"/_devtoys-cli-* "$d"/_node-* "$d"/_go-* "$d"/_lua-language-server-*
  done
  if $use_sudo; then
    rm_p /usr/local/lib/helix /usr/local/lib/node_modules
  fi
  # pip --user era of glances/asciinema/harlequin (now pypi: tools behind shims)
  python3 -m pip uninstall -y -q glances asciinema harlequin >/dev/null 2>&1 || true
  # stamps of the retired Make targets (keep the ones PR2 still owns)
  stamps="$HOME/.local/share/workstation-install"
  if [ -d "$stamps" ]; then
    find "$stamps" -maxdepth 1 -name '*.done' \
      ! -name 'claude-*' ! -name 'nerd-fonts-*' ! -name 'vcpkg-*' ! -name 'python-env-*' \
      ! -name 'docker-engine*' ! -name 'dozzle-service-*' ! -name 'cockpit-service*' \
      ! -name 'rsyslog-service-*' ! -name 'wsl-config-*' -print -delete | sed 's/^/  - removed stamp /'
  fi
  if [ "$failed" -eq 0 ]; then
    mkdir -p "$state" && : >"$marker"
    echo "  ✓ legacy tool installs swept ($marker)"
  else
    printf '  ! legacy sweep incomplete (%d path(s) left) — it retries on the next run\n' "$failed"
  fi
fi

# -----------------------------------------------------------------------------
# PR2 sweep — host-state artifacts Make owned before tasks/* + [bootstrap.*]
# took over: the chezmoi-era pueued unit, the old /usr/local vcpkg tree, the
# Make-era PATH profile.d file, and the pre-mise stamps dir (every stamp
# under it — including the bespoke-target ones the block above preserves —
# is superseded now: tasks/{python-env,fonts,vcpkg} and friends stamp
# $state/…, never …/workstation-install/…). Reuses rm_p/use_sudo/
# sudo_password_needed from above; $failed is reset and reused as THIS
# block's own failure count — the PR1 marker decision above already
# consumed its old value. The "sudo needs a password" line, if any, was
# already printed once by the shared probe above — this block only counts
# it against its own marker, silently.
# -----------------------------------------------------------------------------
host_marker_done=false
if [ -f "$host_marker" ]; then
  echo "  legacy host-state sweep already done ($host_marker)"
  host_marker_done=true
fi
if ! $host_marker_done; then
  failed=0
  # user-level, every host: the chezmoi-era pueued unit. The mise-managed
  # service (config.linux.toml [bootstrap.services.pueued]) is a DIFFERENT
  # unit name (dev.mise.pueued.service), so this plain one is always stale.
  # bootstrap.sh also retires it earlier (Task 4) — this is belt-and-braces.
  pueued_unit="$HOME/.config/systemd/user/pueued.service"
  if [ -f "$pueued_unit" ]; then
    systemctl --user disable --now pueued.service 2>/dev/null || true
    rm_p "$pueued_unit"
    systemctl --user daemon-reload 2>/dev/null || true
  fi
  # sudo-level, dev only: paths only a dev host's Make provision ever wrote.
  # Same sudo -n true probe + skip rule as the sweep above — a prod host (or
  # a dev host whose sudo needs a password) never attempts them, so a stray
  # root-owned leftover there can't withhold this marker forever.
  if $use_sudo; then
    host_paths=(/usr/local/share/vcpkg /usr/local/bin/vcpkg /etc/profile.d/local-bin.sh)
    for p in "${host_paths[@]}"; do
      rm_p "$p"
    done
  elif $sudo_password_needed; then
    failed=$((failed + 1))
  else
    echo "  · no sudo on this host — /usr/local + /etc/profile.d left untouched (prod hosts never received Make installs there)"
  fi
  # user-level, every host.
  rm_p "$HOME/.local/share/workstation-install"
  if [ "$failed" -eq 0 ]; then
    mkdir -p "$state" && : >"$host_marker"
    echo "  ✓ legacy host-state swept ($host_marker)"
  else
    printf '  ! legacy host-state sweep incomplete (%d path(s) left) — it retries on the next run\n' "$failed"
  fi
fi

# -----------------------------------------------------------------------------
# PR3 sweep — chezmoi retired. Its own marker + array name (independent of
# the two sweeps above — a host that already finished PR1/PR2 must still run
# this one the first time it sees the new code). User-level only, no sudo:
# chezmoi never wrote anything under /usr/local or /etc. The chezmoi BINARY
# itself is not removed here — dropping its `[tools]` entry (config.linux.toml)
# and mise's own pruning does that.
# -----------------------------------------------------------------------------
chezmoi_marker_done=false
if [ -f "$chezmoi_marker" ]; then
  echo "  legacy chezmoi sweep already done ($chezmoi_marker)"
  chezmoi_marker_done=true
fi
if ! $chezmoi_marker_done; then
  failed=0
  # chezmoi.toml + its boltdb cache — never key.txt (the age identity, if a
  # host ever had one, is out-of-band and not ours to touch or judge).
  chezmoi_state_files=(
    "$HOME/.config/chezmoi/chezmoistate.boltdb"
    "$HOME/.config/chezmoi/chezmoi.toml"
  )
  rm_p "${chezmoi_state_files[@]}"
  # Stale shims. `mise prune` drops the INSTALL when a tool leaves [tools],
  # but never the shim, and `mise reshim` does not prune either (verified on
  # 2026-09-22, mise 2026.9.9) — so `chezmoi`/`chezit` stay on PATH and answer
  # with "mise ERROR No version is set for shim: chezmoi" instead of the plain
  # "command not found" a retired tool should give.
  shim_dir="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
  for _shim in chezmoi chezit; do
    [ -e "$shim_dir/$_shim" ] && rm_p "$shim_dir/$_shim"
  done
  # ~/.local/share/chezmoi is ALSO the pre-2026-09 location of this very repo
  # checkout (relocate_repo() in bootstrap.sh moves it to ~/.config/mise) —
  # never remove it while a .git dir is still there (means it hasn't been
  # relocated yet, not ours to touch here) or while anything else lives in it
  # (this WSL host keeps an unrelated .remember plugin data dir there).
  chezmoi_share_dir="$HOME/.local/share/chezmoi"
  if [ -d "$chezmoi_share_dir" ] && [ ! -e "$chezmoi_share_dir/.git" ]; then
    if [ -z "$(ls -A "$chezmoi_share_dir" 2>/dev/null)" ]; then
      rm_p "$chezmoi_share_dir"
    else
      printf '  · %s not empty (%s) — left in place, not ours to remove\n' \
        "$chezmoi_share_dir" "$(ls -A "$chezmoi_share_dir" | tr '\n' ' ')"
    fi
  fi
  if [ "$failed" -eq 0 ]; then
    mkdir -p "$state" && : >"$chezmoi_marker"
    echo "  ✓ legacy chezmoi state swept ($chezmoi_marker)"
  else
    printf '  ! legacy chezmoi sweep incomplete (%d path(s) left) — it retries on the next run\n' "$failed"
  fi
fi
exit 0
