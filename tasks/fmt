#!/usr/bin/env bash
#MISE description="shfmt -w -i 2 the first-party shell scripts in place"
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck disable=SC2034  # part of the common task preamble; unused by this task
state="${XDG_STATE_HOME:-$HOME/.local/state}/workstation"
env_has() {
  case ",${MISE_ENV:-}," in *,"$1",*) return 0 ;; esac
  return 1
}
if command -v shfmt >/dev/null 2>&1; then
  cd "$root" && shfmt -w -i 2 bootstrap.sh scripts/*.sh scripts/lib/*.sh tasks/* \
    .claude/hooks/*.sh dotfiles/claude/hooks/*.sh \
    dotfiles/claude/notify.sh \
    dotfiles/local/bin/winterop
  printf 'shfmt -i 2: formatted the first-party shell scripts\n'
else
  printf 'shfmt not installed — mise install shfmt\n'
fi
