#!/usr/bin/env bash
#MISE description="PSScriptAnalyzer over the .ps1 scripts (same check CI runs; soft-skips where pwsh is absent)"
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck disable=SC2034  # part of the common task preamble; unused by this task
state="${XDG_STATE_HOME:-$HOME/.local/state}/workstation"
env_has() {
  case ",${MISE_ENV:-}," in *,"$1",*) return 0 ;; esac
  return 1
}
if command -v pwsh >/dev/null 2>&1; then
  pwsh "$root/scripts/check-ps.ps1"
else
  printf 'pwsh not installed — skipped (CI enforces PowerShell lint)\n'
fi
