#!/usr/bin/env bash
#MISE description="Read-only health report: config set, system steps, bootstrap state, mise tools, free disk, pueued, python-env, extras"
# Report shape: hdr/row_ok/row_warn/row_bad/row_skip. READ-ONLY: no installs,
# no sudo, but exits 1 if any row_bad fired — this is the
# gate CI / a human runs post-bootstrap, not just a report.
# Deliberately no `-e`: one failing row (row_bad) must not abort the report —
# every remaining check still has to run so the summary counts are complete.
set -uo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
RED=$'\033[0;31m'
BLUE=$'\033[0;34m'
BOLD=$'\033[1m'
RESET=$'\033[0m'

n_ok=0
n_warn=0
n_bad=0
n_skip=0

hdr() { printf '%s==>%s %s%s%s\n' "$BLUE" "$RESET" "$BOLD" "$*" "$RESET"; }
row_ok() {
  printf ' %s✓%s %-16s %s\n' "$GREEN" "$RESET" "$1" "$2"
  n_ok=$((n_ok + 1))
}
row_warn() {
  printf ' %s!%s %-16s %s\n' "$YELLOW" "$RESET" "$1" "$2"
  n_warn=$((n_warn + 1))
}
row_bad() {
  printf ' %s✗%s %-16s %s\n' "$RED" "$RESET" "$1" "$2"
  n_bad=$((n_bad + 1))
}
row_skip() {
  printf ' · %-16s %s\n' "$1" "$2"
  n_skip=$((n_skip + 1))
}

cfg="$root/config.local.toml"
canonical_env=$("$root/scripts/lib/mise-env.sh" 2>/dev/null)
rc_tokens=$(sed -n 's/^env = \[\(.*\)\]$/\1/p' "$root/miserc.toml" 2>/dev/null | tr -d '" ')
sudo_saved=$("$root/scripts/lib/bootstrap-fn.sh" config_get "$cfg" sudo 2>/dev/null)

hdr "workstation health — config=${rc_tokens:-unset} · read-only"
echo ""

hdr "config set and system steps"
if [ "$rc_tokens" = "$canonical_env" ]; then
  row_ok "miserc" "$root/miserc.toml selects $rc_tokens"
else
  row_bad "miserc" "$root/miserc.toml has \"${rc_tokens:-<missing>}\", this host needs \"$canonical_env\" — mise run update"
fi
if [ "$sudo_saved" = no ]; then
  row_warn "system steps" "skipped: sudo = \"no\" in config.local.toml (dnf, /etc files, login shell) — re-run $root/bootstrap.sh with sudo"
else
  row_ok "system steps" "applied${sudo_saved:+ (sudo = $sudo_saved)}"
fi
# The report's own mise calls follow miserc.toml, as every other mise process does.
unset MISE_ENV
echo ""

# 1. mise bootstrap status — packages/files/services/compose/repos per origin
# file, one host-state gate over everything [bootstrap.*] owns. The table is for
# the reader; every row below classifies from ONE `--json` call, by its exact
# state/action fields (never the table: a suffix match on words like "installed"
# would mask a row reading "not installed").
hdr "bootstrap state (mise bootstrap status --missing)"
bootstrap_out=$(mise bootstrap status --missing 2>&1)
bootstrap_rc=$?
printf '%s\n' "$bootstrap_out" | sed 's/^/   /'
# Four lines: the drift class (real, excused, skipped:<n> or none), "tools:" and
# the missing tools, "dotfiles:" and how many dotfile entries/edits aren't applied,
# "lazy:" and the lazy tools not yet installed (not drift, below).
# Empty without jq or readable JSON; the rows below then fail or warn (the safe
# direction).
# Drift that is NOT a problem, which the advice below could never clear:
# - excused: a host with no systemd user manager (no logind session) reports the
#   pueued user service as `unavailable: systemd user manager not available`, yet
#   `mise bootstrap` itself skips that service cleanly and exits 0;
# - skipped: with sudo = "no" the dnf packages and /etc files are skipped on purpose
#   (the system steps row above says so), and `mise bootstrap status` has no --skip;
# - lazy: a `lazy = true` tool (graft) installs the first time its command runs, so
#   it reads as missing until then. The names come from config.toml/config.linux.toml
#   (`mise tool --json` reports lazy = null once a lock entry exists).
lazy_tools=$(for f in "$root/config.toml" "$root/config.linux.toml"; do
  mise config get -f "$f" tools 2>/dev/null
done | awk '/^\[/ { name = $0; gsub(/^\["?|"?\]$/, "", name) } $0 == "lazy = true" { print name }' | paste -sd' ' -)
facts=$(mise bootstrap status --json 2>/dev/null | SKIP_SYSTEM="$([ "$sudo_saved" = no ] && echo 1)" LAZY="$lazy_tools" jq -r '
  def settled: (.action // "") as $a | $a == "" or $a == "noop" or $a == "unchanged";
  (($ENV.SKIP_SYSTEM // "") != "") as $skip
  | ($ENV.LAZY // "" | split(" ")) as $lazy
  | [(.packages // {}) | to_entries[] | .key as $m | .value
      | (if has("available") and (.available | not) then "\($m) unavailable" else empty end),
        ((.packages // [])[] | select(.state != "installed") | "\($m):\(.package)")] as $pkgs
  | [.tools[]? | select(.installed | not) | .tool] as $unset
  | [$unset[] | select(IN($lazy[]) | not)] as $tools
  | [$unset[] | select(IN($lazy[]))] as $later
  | [("files", "services", "compose", "repos", "accounts", "firewall", "mise_shell_activate", "user_services") as $k
      | (.[$k] // [])[] | select(settled | not)
      | if $k == "user_services" and ((.current // "") | tostring | contains("systemd user manager not available")) then "excused"
        elif $k == "files" and $skip then "skipped"
        else "real" end] as $res
  | ((if $skip then $pkgs else [] end) + [$res[] | select(. == "skipped")]) as $skipped
  | if (if $skip then [] else $pkgs end) + $tools + [$res[] | select(. == "real")] != [] then "real"
    elif any($res[]; . == "excused") then "excused"
    elif $skipped != [] then "skipped:\($skipped | length)"
    else "none" end,
    "tools:" + ($tools | sort | join(" ")),
    "dotfiles:\([(.dotfiles.files // [])[], (.dotfiles.edits // [])[] | select(.state != "applied")] | length)",
    "lazy:" + ($later | sort | join(" "))
' 2>/dev/null)
{
  IFS= read -r bootstrap_why
  IFS= read -r tools_line
  IFS= read -r dotfiles_line
  IFS= read -r lazy_line
} <<<"$facts"
later=${lazy_line#lazy:}
if [ "$bootstrap_rc" -eq 0 ]; then
  row_ok "bootstrap state" "current"
else
  case "$bootstrap_why" in
  excused)
    row_warn "bootstrap state" "pueued skipped — no systemd user manager on this host (loginctl enable-linger to run it)"
    ;;
  skipped:*)
    row_ok "bootstrap state" "current apart from the skipped system steps (${bootstrap_why#skipped:} dnf/file item(s))"
    ;;
  none)
    # Every [bootstrap.*] resource is settled, but --missing also counts [dotfiles]
    # drift: the dotfiles row below owns that, so it isn't reported twice at
    # hard-failure severity. Drift with no cause in the JSON stays a failure.
    if [ "$dotfiles_line" = dotfiles:0 ] && [ -n "$later" ]; then
      row_ok "bootstrap state" "current (lazy tools install on first use)"
    elif [ "$dotfiles_line" = dotfiles:0 ]; then
      row_bad "bootstrap state" "drift reported by --missing but not visible in --json — inspect: mise bootstrap status"
    else
      row_warn "bootstrap state" "drift is dotfiles-only (see the dotfiles row below) — inspect: mise dot status"
    fi
    ;;
  *)
    row_bad "bootstrap state" "drift — run ./bootstrap.sh"
    ;;
  esac
fi

# 2. mise-installed tools
hdr "mise tools"
missing_tools=${tools_line#tools:}
if [ "${tools_line:0:6}" != tools: ]; then
  row_bad "mise tools" "can't tell: no readable mise bootstrap status --json — mise doctor"
elif [ -z "$missing_tools" ]; then
  row_ok "mise tools" "every declared tool installed${later:+ (on first use: $later)}"
else
  n_missing=$(wc -w <<<"$missing_tools")
  row_bad "mise tools" "$n_missing missing ($missing_tools) — mise install"
fi
# An update installs new versions before `mise prune` drops the old ones;
# scripts/lib/mise-install.sh stops when free space is below what is left to
# install plus 1 GB.
mise_data="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
free_mb=$(df -Pk "$mise_data" 2>/dev/null | awk 'NR == 2 { print int($4 / 1024) }')
if [ -z "$free_mb" ]; then
  row_skip "disk" "could not read the free space for $mise_data"
elif [ "$free_mb" -lt 2048 ]; then
  row_warn "disk" "$(awk -v m="$free_mb" 'BEGIN { printf "%.1f GB", m / 1024 }') free where mise installs tools — an update needs about 1 GB on top of what it installs; free some space (du -xh --max-depth=1 ~ | sort -rh | head)"
else
  row_ok "disk" "$(awk -v m="$free_mb" 'BEGIN { printf "%.1f GB", m / 1024 }') free where mise installs tools"
fi
echo ""

# 3. pueued — the mise-managed user unit.
hdr "pueued"
if systemctl --user is-active --quiet dev.mise.pueued.service 2>/dev/null; then
  row_ok "pueued" "dev.mise.pueued.service active"
elif systemctl --user is-failed --quiet dev.mise.pueued.service 2>/dev/null; then
  row_bad "pueued" "unit failed — run: journalctl --user -u dev.mise.pueued -n 3"
else
  row_warn "pueued" "dev.mise.pueued.service not active — mise bootstrap --only services"
fi
echo ""

# 4. python-env — wpy's own reported version must match mise's python.
hdr "python-env"
if [ -x "$HOME/.local/bin/wpy" ]; then
  want_v=$(mise current python 2>/dev/null || true)
  wpy_v=$("$HOME/.local/bin/wpy" -c 'import sys;print(sys.version.split()[0])' 2>/dev/null || true)
  if [ "$wpy_v" = "$want_v" ]; then
    row_ok "python-env" "wpy -> CPython $wpy_v"
  else
    row_bad "python-env" "wpy reports '${wpy_v:-?}', want ${want_v:-?} — mise run python-env"
  fi
else
  row_bad "python-env" "missing: ~/.local/bin/wpy — mise run python-env"
fi
echo ""

# 5. zjstatus — config.linux.toml's zjstatus tool loads on every Linux host, and
# zellij loads it from mise's install dir (see config.kdl).
hdr "zjstatus"
zjs="$HOME/.local/share/mise/installs/github-dj95-zjstatus/latest/zjstatus.wasm"
if [ -f "$zjs" ]; then
  row_ok "zjstatus" "plugin at $zjs"
else
  row_bad "zjstatus" "zjstatus.wasm missing at $zjs — mise install github:dj95/zjstatus"
fi
echo ""

# 6. extras
hdr "extras"
if command -v claude >/dev/null 2>&1; then
  row_ok "claude" "$(command -v claude)"
else
  row_bad "claude" "not on PATH — mise run bootstrap"
fi
if [ -x "$HOME/.local/bin/vcpkg" ] && [ -x "$HOME/.local/share/vcpkg/vcpkg" ]; then
  row_ok "vcpkg" "present: ~/.local/bin/vcpkg -> ~/.local/share/vcpkg/vcpkg"
else
  row_bad "vcpkg" "missing — mise run vcpkg"
fi
if ! "$root/scripts/lib/bootstrap-fn.sh" is_wsl; then
  fdir="$HOME/.local/share/fonts/JetBrainsMonoNerdFontMono"
  if [ -d "$fdir" ] && [ -n "$(find "$fdir" -maxdepth 1 -name '*.ttf' -print -quit 2>/dev/null)" ]; then
    row_ok "fonts" "$fdir has TTFs"
  else
    row_bad "fonts" "no TTFs in $fdir — mise run fonts"
  fi
else
  row_skip "fonts" "WSL — the Windows terminal resolves fonts"
fi
echo ""

# 7. shell and dotfiles
hdr "shell and dotfiles"
login_shell=$(getent passwd "$USER" | cut -d: -f7)
if [ "$(basename "$login_shell")" = zsh ]; then
  row_ok "login shell" "$login_shell"
else
  row_warn "login shell" "$login_shell — expected zsh; $root/bootstrap.sh sets it (usermod, or an SSSD override for a directory account)"
fi
if [ "$dotfiles_line" = dotfiles:0 ]; then
  row_ok "dotfiles" "no drift (mise dot status)"
else
  row_warn "dotfiles" "drift — inspect: mise dot status · apply: mise dot apply"
fi
# A dirty checkout (a hand-edited pin, a wse/wsr/`mise dot add` write to a
# source under dotfiles/) makes the next wsu's `git pull --ff-only` fail.
repo_dirty=$(git -C "$root" status --porcelain 2>/dev/null | wc -l)
if [ "$repo_dirty" -eq 0 ]; then
  row_ok "repo checkout" "clean ($root)"
else
  row_warn "repo checkout" "$repo_dirty uncommitted change(s) in $root — commit or stash before the next wsu (its git pull --ff-only fails on local changes)"
fi
echo ""

hdr "summary"
printf '   %d ok · %d warnings · %d problems · %d n/a\n' "$n_ok" "$n_warn" "$n_bad" "$n_skip"
if [ "$n_bad" -eq 0 ]; then
  echo "health: OK"
  exit 0
else
  echo "health: $n_bad problem(s)"
  exit 1
fi
