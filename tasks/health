#!/usr/bin/env bash
#MISE description="Read-only health report: config set, system steps, bootstrap state, mise tools, free disk, pueued, python-env, extras"
# Report shape: hdr/row_ok/row_warn/row_bad/row_skip. READ-ONLY: no installs,
# no sudo, but exits 1 if any row_bad fired — this is the
# gate CI / a human runs post-bootstrap, not just a report.
# Deliberately no `-e`: one failing row (row_bad) must not abort the report —
# every remaining check still has to run so the summary counts are complete.
set -uo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# A python with `json` for parsing `mise bootstrap status --json` (below).
# wpy is python-env's launcher; mise's own python and the system
# interpreter are the fallbacks. Empty when none exists — the one caller treats
# that as "cannot classify" and fails the row rather than passing it.
PY=""
for _py in "$HOME/.local/bin/wpy" python3 python; do
  if command -v "$_py" >/dev/null 2>&1 && "$_py" -c 'import json' >/dev/null 2>&1; then
    PY="$_py"
    break
  fi
done

GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
RED=$'\033[0;31m'
BLUE=$'\033[0;34m'
BOLD=$'\033[1m'
RESET=$'\033[0m'

n_ok=0
n_warn=0
n_bad=0
n_skip=0

hdr() { printf '%s==>%s %s%s%s\n' "$BLUE" "$RESET" "$BOLD" "$*" "$RESET"; }
row_ok() {
  printf ' %s✓%s %-16s %s\n' "$GREEN" "$RESET" "$1" "$2"
  n_ok=$((n_ok + 1))
}
row_warn() {
  printf ' %s!%s %-16s %s\n' "$YELLOW" "$RESET" "$1" "$2"
  n_warn=$((n_warn + 1))
}
row_bad() {
  printf ' %s✗%s %-16s %s\n' "$RED" "$RESET" "$1" "$2"
  n_bad=$((n_bad + 1))
}
row_skip() {
  printf ' · %-16s %s\n' "$1" "$2"
  n_skip=$((n_skip + 1))
}

cfg="$root/config.local.toml"
canonical_env=$("$root/scripts/lib/mise-env.sh" 2>/dev/null)
rc_tokens=$(sed -n 's/^env = \[\(.*\)\]$/\1/p' "$root/miserc.toml" 2>/dev/null | tr -d '" ')
sudo_saved=$(WORKSTATION_BOOTSTRAP_LIB=1 bash -c 'source "$1"; config_get "$2" sudo' _ "$root/bootstrap.sh" "$cfg" 2>/dev/null)

hdr "workstation health — config=${rc_tokens:-unset} · read-only"
echo ""

hdr "config set and system steps"
if [ "$rc_tokens" = "$canonical_env" ]; then
  row_ok "miserc" "$root/miserc.toml selects $rc_tokens"
else
  row_bad "miserc" "$root/miserc.toml has \"${rc_tokens:-<missing>}\", this host needs \"$canonical_env\" — mise run update"
fi
if [ "$sudo_saved" = no ]; then
  row_warn "system steps" "skipped: sudo = \"no\" in config.local.toml (dnf, /etc files, login shell) — re-run $root/bootstrap.sh with sudo"
else
  row_ok "system steps" "applied${sudo_saved:+ (sudo = $sudo_saved)}"
fi
# The report's own mise calls follow miserc.toml, as every other mise process does.
unset MISE_ENV
echo ""

# 1. mise bootstrap status — packages/files/services/compose/repos per origin
# file, one host-state gate over everything [bootstrap.*] owns.
hdr "bootstrap state (mise bootstrap status --missing)"
bootstrap_out=$(mise bootstrap status --missing 2>&1)
bootstrap_rc=$?
printf '%s\n' "$bootstrap_out" | sed 's/^/   /'
if [ "$bootstrap_rc" -eq 0 ]; then
  row_ok "bootstrap state" "current"
else
  # Drift. One case is NOT a problem: a host with no systemd user manager (a
  # shared host reached without a logind session) reports the pueued user service
  # as `unavailable: systemd user manager not available`, yet `mise bootstrap`
  # itself skips that service cleanly and exits 0 — so the advice below could
  # never clear the row. Classify from `--json`'s exact state/action fields
  # (never the human table: a suffix match on words like "installed" would
  # mask a row reading "not installed"). No JSON-capable python => fall back
  # to failing the row, which is the safe direction.
  bootstrap_why=$(mise bootstrap status --json 2>/dev/null | "$PY" -c '
import json, sys

try:
    d = json.load(sys.stdin)
except Exception:
    print("unparseable")
    sys.exit(0)

SETTLED_ACTIONS = {"noop", "unchanged"}
excused, real = [], []

for mgr, info in (d.get("packages") or {}).items():
    if not info.get("available", True):
        real.append("package manager %s unavailable" % mgr)
    for p in info.get("packages") or []:
        if p.get("state") != "installed":
            real.append("%s:%s %s" % (mgr, p.get("package"), p.get("state")))

for t in d.get("tools") or []:
    if not t.get("installed"):
        real.append("tool %s %s" % (t.get("tool"), t.get("state")))

for key in ("files", "services", "compose", "repos", "accounts", "firewall",
            "mise_shell_activate", "user_services"):
    for r in d.get(key) or []:
        if (r.get("action") or "noop") in SETTLED_ACTIONS:
            continue
        name = r.get("name") or (r.get("id") or {}).get("name") or key
        cur = str(r.get("current") or "")
        if key == "user_services" and "systemd user manager not available" in cur:
            excused.append(name)
        else:
            real.append("%s %s -> %s" % (name, cur or "?", r.get("action")))

print("real:" + "; ".join(real[:6]) if real else
      ("excused:" + ", ".join(excused) if excused else "none"))
' 2>/dev/null)
  case "$bootstrap_why" in
  excused:*)
    row_warn "bootstrap state" "pueued skipped — no systemd user manager on this host (loginctl enable-linger to run it)"
    ;;
  none)
    # --missing said drift, the JSON says every [bootstrap.*] resource is
    # settled. One known, non-bad cause: `mise bootstrap status --json`'s
    # top-level exit code also reflects [dotfiles] drift (its "dotfiles" key
    # is just {"edits": []} — no per-target state to classify, unlike
    # files/services/etc above), so a single un-applied dotfile makes
    # `--missing` exit non-zero with nothing "real" for this classifier to
    # find. Don't guess from the JSON (it structurally can't tell us) —
    # re-probe with the SAME command the dedicated "dotfiles" row below uses
    # and let that row own dotfiles drift instead of double-reporting it here
    # at hard-failure severity. If dotfiles are ALSO clean, the drift is
    # genuinely unattributable and stays a hard failure.
    if mise dot status --missing >/dev/null 2>&1; then
      row_bad "bootstrap state" "drift reported by --missing but not visible in --json — inspect: mise bootstrap status"
    else
      row_warn "bootstrap state" "drift is dotfiles-only (see the dotfiles row below) — inspect: mise dot status"
    fi
    ;;
  *)
    row_bad "bootstrap state" "drift — run ./bootstrap.sh"
    ;;
  esac
fi

# 2. mise-installed tools
hdr "mise tools"
missing_tools=$(mise ls --missing 2>/dev/null | awk 'NF {print $1}' | paste -sd' ' -)
if [ -z "$missing_tools" ]; then
  row_ok "mise tools" "every declared tool installed"
else
  n_missing=$(wc -w <<<"$missing_tools")
  row_bad "mise tools" "$n_missing missing ($missing_tools) — mise install"
fi
# An update installs new versions before `mise prune` drops the old ones, and
# scripts/lib/mise-install.sh refuses to start with less than 1.5 GB free.
mise_data="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
free_mb=$(df -Pk "$mise_data" 2>/dev/null | awk 'NR == 2 { print int($4 / 1024) }')
if [ -z "$free_mb" ]; then
  row_skip "disk" "could not read the free space for $mise_data"
elif [ "$free_mb" -lt 2048 ]; then
  row_warn "disk" "$(awk -v m="$free_mb" 'BEGIN { printf "%.1f GB", m / 1024 }') free where mise installs tools — updates need 1.5 GB; free some space (du -xh --max-depth=1 ~ | sort -rh | head)"
else
  row_ok "disk" "$(awk -v m="$free_mb" 'BEGIN { printf "%.1f GB", m / 1024 }') free where mise installs tools"
fi
echo ""

# 4. pueued — the mise-managed user unit.
hdr "pueued"
if systemctl --user is-active --quiet dev.mise.pueued.service 2>/dev/null; then
  row_ok "pueued" "dev.mise.pueued.service active"
elif systemctl --user is-failed --quiet dev.mise.pueued.service 2>/dev/null; then
  row_bad "pueued" "unit failed — run: journalctl --user -u dev.mise.pueued -n 3"
else
  row_warn "pueued" "dev.mise.pueued.service not active — mise bootstrap --only services"
fi
echo ""

# 5. python-env — wpy's own reported version must match mise's python.
hdr "python-env"
if [ -x "$HOME/.local/bin/wpy" ]; then
  want_v=$(mise current python 2>/dev/null || true)
  wpy_v=$("$HOME/.local/bin/wpy" -c 'import sys;print(sys.version.split()[0])' 2>/dev/null || true)
  if [ "$wpy_v" = "$want_v" ]; then
    row_ok "python-env" "wpy -> CPython $wpy_v"
  else
    row_bad "python-env" "wpy reports '${wpy_v:-?}', want ${want_v:-?} — mise run python-env"
  fi
else
  row_bad "python-env" "missing: ~/.local/bin/wpy — mise run python-env"
fi
echo ""

# 6. zjstatus — config.linux.toml's zjstatus tool loads on every Linux host, and
# zellij loads it from mise's install dir (see config.kdl).
hdr "zjstatus"
zjs="$HOME/.local/share/mise/installs/github-dj95-zjstatus/latest/zjstatus.wasm"
if [ -f "$zjs" ]; then
  row_ok "zjstatus" "plugin at $zjs"
else
  row_bad "zjstatus" "zjstatus.wasm missing at $zjs — mise install github:dj95/zjstatus"
fi
echo ""

# 7. extras
hdr "extras"
if command -v claude >/dev/null 2>&1; then
  row_ok "claude" "$(command -v claude)"
else
  row_bad "claude" "not on PATH — mise run bootstrap"
fi
if [ -x "$HOME/.local/bin/vcpkg" ] && [ -x "$HOME/.local/share/vcpkg/vcpkg" ]; then
  row_ok "vcpkg" "present: ~/.local/bin/vcpkg -> ~/.local/share/vcpkg/vcpkg"
else
  row_bad "vcpkg" "missing — mise run vcpkg"
fi
if ! WORKSTATION_BOOTSTRAP_LIB=1 bash -c 'source "$1"; is_wsl' _ "$root/bootstrap.sh"; then
  fdir="$HOME/.local/share/fonts/JetBrainsMonoNerdFontMono"
  if [ -d "$fdir" ] && [ -n "$(find "$fdir" -maxdepth 1 -name '*.ttf' -print -quit 2>/dev/null)" ]; then
    row_ok "fonts" "$fdir has TTFs"
  else
    row_bad "fonts" "no TTFs in $fdir — mise run fonts"
  fi
else
  row_skip "fonts" "WSL — the Windows terminal resolves fonts"
fi
echo ""

# 8. shell and dotfiles
hdr "shell and dotfiles"
login_shell=$(getent passwd "$USER" | cut -d: -f7)
if [ "$(basename "$login_shell")" = zsh ]; then
  row_ok "login shell" "$login_shell"
else
  row_warn "login shell" "$login_shell — expected zsh"
fi
if mise dot status --missing >/dev/null 2>&1; then
  row_ok "dotfiles" "no drift (mise dot status)"
else
  row_warn "dotfiles" "drift — inspect: mise dot status · apply: mise dot apply"
fi
# A dirty checkout (a hand-edited pin, a wse/wsr/`mise dot add` write to a
# source under dotfiles/) makes the next wsu's `git pull --ff-only` fail.
repo_dirty=$(git -C "$root" status --porcelain 2>/dev/null | wc -l)
if [ "$repo_dirty" -eq 0 ]; then
  row_ok "repo checkout" "clean ($root)"
else
  row_warn "repo checkout" "$repo_dirty uncommitted change(s) in $root — commit or stash before the next wsu (its git pull --ff-only fails on local changes)"
fi
echo ""

hdr "summary"
printf '   %d ok · %d warnings · %d problems · %d n/a\n' "$n_ok" "$n_warn" "$n_bad" "$n_skip"
if [ "$n_bad" -eq 0 ]; then
  echo "health: OK"
  exit 0
else
  echo "health: $n_bad problem(s)"
  exit 1
fi
