#!/usr/bin/env bash
#MISE description="mise outdated --bump, dnf check-update (dev), and config.toml [vars] pins vs upstream release tags"
#MISE env={PYTHON_VERSION="{{ vars.python_version }}", NERD_FONT_VERSION="{{ vars.nerd_font_version }}", VCPKG_VERSION="{{ vars.vcpkg_version }}"}
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck disable=SC2034  # part of the common task preamble; unused by this task
state="${XDG_STATE_HOME:-$HOME/.local/state}/workstation"
env_has() {
  case ",${MISE_ENV:-}," in *,"$1",*) return 0 ;; esac
  return 1
}

printf '==> mise tools\n'
mise outdated --bump || true

if env_has host && command -v dnf >/dev/null 2>&1; then
  printf '\n==> dnf\n'
  dnf -q check-update | head -40 || true # exit 100 = updates exist; never fail this task
fi

printf '\n==> host pins (config.toml [vars])\n'
printf '%s\n' \
  "nerd-fonts|$NERD_FONT_VERSION|ryanoasis/nerd-fonts|v$NERD_FONT_VERSION" \
  "vcpkg|$VCPKG_VERSION|microsoft/vcpkg|$VCPKG_VERSION" \
  "python-env|$PYTHON_VERSION|python/cpython|v$PYTHON_VERSION" \
  "claude-cli|latest|-|-" |
  "$root/scripts/lib/check-updates.sh"
