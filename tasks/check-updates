#!/usr/bin/env bash
#MISE description="Report available updates: mise tool pins, dnf (Linux hosts with dnf), and the config.toml [vars] pins vs upstream tags"
#MISE env={VCPKG_VERSION="{{ vars.vcpkg_version }}"}
set -uo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

printf '==> mise tools\n'
mise outdated --bump || true

if command -v dnf >/dev/null 2>&1; then
  printf '\n==> dnf\n'
  dnf -q check-update | head -40 || true # exit 100 means updates exist; never fail
fi

# report <name> <pinned> <github owner/repo>: the newest clean numeric tag upstream
# (scripts/lib/latest-tag.sh, which bump-versions.sh bumps to as well) vs the pin.
report() {
  local latest
  latest=$("$root/scripts/lib/latest-tag.sh" "$3")
  if [ -z "$latest" ]; then
    printf '  ? %-12s %s (no tags found; offline?)\n' "$1" "$2"
  elif [ "$latest" = "$2" ]; then
    printf '  ✓ %-12s %s\n' "$1" "$2"
  else
    printf '  ↑ %-12s %s → %s\n' "$1" "$2" "$latest"
  fi
}
printf '\n==> config.toml [vars] pins\n'
report vcpkg "$VCPKG_VERSION" microsoft/vcpkg
