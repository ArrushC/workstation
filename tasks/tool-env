#!/usr/bin/env bash
#MISE description="Sync locked Python and language-server environments after installing runtimes"
#USAGE flag "--clean" help="Then delete superseded generations and mise prune runtimes nothing uses"
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
args=()
if [ "${usage_clean:-false}" = true ]; then args+=(--clean); fi
exec python3 "$root/scripts/tool-env.py" all "${args[@]}"
