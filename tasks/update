#!/usr/bin/env bash
#MISE description="git pull --ff-only + mise install + mise bootstrap on this host"
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck disable=SC2034  # part of the common task preamble; unused by this task
state="${XDG_STATE_HOME:-$HOME/.local/state}/workstation"
env_has() {
  case ",${MISE_ENV:-}," in *,"$1",*) return 0 ;; esac
  return 1
}
# Same guard as bootstrap.sh's apply(): the generated pueued unit
# carries no Environment= line, so a manager whose live env predates
# ~/.config/environment.d/10-mise.conf needs MISE_ENV pushed onto it before
# `mise bootstrap` restarts the service, or the shim sees "No version is set
# for shim: pueued".
git -C "$root" pull --ff-only && "$root/scripts/lib/mise-install.sh" &&
  {
    systemctl --user show-environment >/dev/null 2>&1 && systemctl --user set-environment "MISE_ENV=${MISE_ENV:-}"
    true
  } &&
  mise bootstrap --yes
