#!/usr/bin/env bash
#MISE description="scan the working tree for committed secrets with gitleaks"
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck disable=SC2034  # part of the common task preamble; unused by this task
state="${XDG_STATE_HOME:-$HOME/.local/state}/workstation"
env_has() {
  case ",${MISE_ENV:-}," in *,"$1",*) return 0 ;; esac
  return 1
}
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks dir --no-banner --redact -c "$root/.gitleaks.toml" "$root"
else
  printf 'gitleaks not installed — mise install gitleaks\n'
fi
