# Sensitive — never commit these
*.key
*.pem
id_rsa
id_ed25519
.env
.env.*
secrets/

# Local machine overrides
miserc.toml*
.bashrc.local

# Python
__pycache__/
*.pyc
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# Per-host mise overrides (name/email vars from PR3 onward) — never committed
config.local.toml

# Per-host lock for tools a host adds in config.local.toml (`mise lock --global` writes it)
mise.local.lock

# What Claude Code writes beside a mod it loads with --plugin-dir (its API's types, and a
# tsconfig.json that extends them); generated per build, never committed
.claude/skills/*/tsconfig.json
.claude/skills/*/.claude-plugin/types/
